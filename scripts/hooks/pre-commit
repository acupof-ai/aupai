                                      "--selftest-detector"),
        # No partial half exists: every assertion in it runs K rollouts, so there is nothing
        # to split off the way code_reward's detector cases split off. 6.3s measured, which
        # is affordable -- the reason is the host, not the clock. Verified by hand on both,
        # 2026-09-02: Mac/seatbelt 10 ok 4.4x parallel, pod/sandbox_exec 10 ok 2.4x, the same
        # ten rewards, and the two escape probes confirmed to FIRE at level rlimits_only
        # (reward 0.0, escaped true, /Users/bytedance/.ssh named in the failure).
        "algorithms/rollout.py": "every assertion runs rollouts in a sandbox; needs a host "
                                 "with process isolation, which CI is not",
    }
    # The STAGED blob, never the working tree. The gate's whole claim is "the version
    # being committed passes its own selftest", and running the working-tree copy tests
    # a version that may not be the one entering history. Constructed and confirmed:
    # stage a broken version, revert the working tree without staging, and the hook is
    # green while the broken version lands (Codex found it, de reproduced it,
    # 2026-09-01). The manifest half of this same hook already argues exactly this at
    # the `git show :scripts/pod_drift.py` below -- the rule was stated and then not
    # applied twelve lines above it.
    #
    # scripts/harness.py used to be exempt here, on the grounds that `harness check` is
    # its selftest. It is not: `check` runs run_checks(), while `--selftest` is what
    # verifies every check FAILs on its broken world. The core proof of the whole
    # harness has never run at commit time. It runs now, and it is slower than the rest
    # of this gate combined, which is the honest cost of actually checking.
    # The staged blob runs from a sibling path NEXT TO the real file. Two earlier
    # placements failed, and both for the same reason: a file's ROOT is
    # __file__-relative, so wherever the copy sits is what ROOT means to it.
    # repo_root()/.git raised NotADirectoryError in every linked worktree (.git is a
    # 60-byte file there) and blocked five sessions from committing; the
    # `git rev-parse --git-path hook-staged` tree that replaced it resolved, but every
    # path the file derived -- imports AND data -- then pointed into that empty tree.
    # PYTHONPATH can patch the imports; it cannot patch a data path, and
    # datagen/build_corpus.py resolves filters/pass1_garbage.py from ROOT and died on
    # FileNotFoundError. A red that says nothing about the commit is the same
    # false-alarm class as a green that says nothing: both make the gate unreadable.
    # Beside the real file, ROOT is the repo, and only the file under test differs.
    # try/finally, not a line after the loop: these copies now live in the WORKING TREE,
    # so a refusal that returns early would leave a .hookstaged_* file behind for the
    # next session to find dirty. The parallel tree could be left to rot; this cannot.
    staged_copies = []
    # Files whose exemption is partial: run the flag that names the assertions which DO
    # work here, instead of skipping the file entirely.
    PARTIAL = {f: v[1] for f, v in NEEDS_DATA.items() if isinstance(v, tuple)}
    # Files that run fully but whose pass/fail verdict is not on the default flag. Kept
    # separate from PARTIAL: that map means "exempt, run the subset that works here",
    # and its entries are NEEDS_DATA rows. This one means "runs everything, but say
    # which flag makes a failure fatal" -- putting scripts/test_recipe_required.py in
    # PARTIAL would have recorded it as data-exempt, which is false and would mislead
    # the next reader of NEEDS_DATA.
    SELFTEST_FLAG = {"scripts/test_recipe_required.py": "--strict"}
    # Measured per selftest, not once around the loop, so the refusal can name WHICH
    # one did it (e1-14). A single before/after pair would say "something changed".
    state_before = _shared_repo_state(repo_root())
    try:
        for f in sorted((SELFTEST_FILES | set(PARTIAL)) & set(staged("AM"))):
            blob = subprocess.run(["git", "show", f":{f}"], capture_output=True)
            if blob.returncode != 0:
                print(f"REFUSING: cannot read staged {f}", file=sys.stderr)
                sys.exit(1)
            d, base = os.path.split(os.path.join(repo_root(), f))
            dst = os.path.join(d, f".hookstaged_{base}")
            staged_copies.append(dst)
            with open(dst, "wb") as fh:
                fh.write(blob.stdout)
            flag = PARTIAL.get(f) or SELFTEST_FLAG.get(f, "--selftest")
            r = subprocess.run([sys.executable, dst, flag], capture_output=True,
                               text=True, cwd=repo_root(),
                               env={k: v for k, v in os.environ.items() if not k.startswith("GIT_")})
            if r.returncode != 0:
                tail = (r.stdout + r.stderr).strip().splitlines()[-6:]
                print(f"REFUSING: {f} {flag} failed (staged version):\n" + "\n".join(tail),
                      file=sys.stderr)
                sys.exit(1)
            # A selftest that PASSED can still have written to the shared repo, and that
            # is the worse case: rc=0 reads as "verified" while another session's git is
            # already broken. Checked after the rc check so a crashing selftest reports
            # its own error first.
            after = _shared_repo_state(repo_root())
            if after != state_before:
                what = []
                if after[0] != state_before[0]:
                    what.append(f".git/config changed ({state_before[0]} -> {after[0]})")
                gained, lost = after[1] - state_before[1], state_before[1] - after[1]
                if gained:
                    what.append(f"staged {sorted(gained)[:4]}")
                if lost:
                    what.append(f"unstaged {sorted(lost)[:4]}")
                print(f"REFUSING: {f} --selftest changed the SHARED repo: "
                      + "; ".join(what) + ".\n"
                      "It passed, which makes this worse than a failure: rc=0 reads as "
                      "verified while every other session's git is already broken.\n"
                      "A selftest must build its world from nothing the caller is "
                      "holding -- strip GIT_* from every subprocess it spawns "
                      "(pod_drift.py:61-66).",
                      file=sys.stderr)
                sys.exit(1)
    finally:
        for p in staged_copies:
            if os.path.exists(p):
                os.unlink(p)
    print(f"hook: selftests {time.time() - t0:.2f}s", file=sys.stderr)

    # Harness check: the full invariant suite. ~5s locally; GPU/pod checks SKIP
    # on dev machines. CI is the second line; the commit is the first.
    t0 = time.time()
    repo = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    ).stdout.strip()
    if repo and os.path.isfile(os.path.join(repo, "scripts", "harness.py")):
        try:
            r = subprocess.run(
                [sys.executable, os.path.join(repo, "scripts", "harness.py"), "check"],
                capture_output=True, text=True, timeout=180,
            )
        except subprocess.TimeoutExpired:
            print("REFUSING: harness check did not finish in 180s -- rerun it by hand; "
                  "a hook that hangs is a hook people bypass", file=sys.stderr)
            sys.exit(1)
        if r.returncode != 0:
            # stdout AND stderr, and the FAIL lines pulled out. Printing stdout alone
            # produced "REFUSING: harness check failed:" with an empty reason when the
            # run crashed or a check raised, because those write to stderr (fb,
            # 2026-08-31). A refusal that does not say what failed cannot be acted on.
            failed = [ln for ln in r.stdout.splitlines() if "[FAIL]" in ln]
            print("REFUSING: harness check failed", file=sys.stderr)
            for ln in failed:
                print(f"  {ln.strip()}", file=sys.stderr)
            if not failed:
                print("  (no [FAIL] line -- the check run itself failed)", file=sys.stderr)
                print(f"  exit {r.returncode}", file=sys.stderr)
                tail = (r.stderr or r.stdout or "").strip().splitlines()[-15:]
                for ln in tail:
                    print(f"  {ln}", file=sys.stderr)
            # A ledger another session is mid-write reads as malformed for a moment.
            # Say so rather than leaving the reader to guess at a transient.
            print("  if this passes when rerun by hand, a concurrent write raced a "
                  "ledger read -- report it, do not --no-verify", file=sys.stderr)
            sys.exit(1)
        # TIMEOUT lines print on a PASSING run too. A check that hit its deadline did
        # not run, and the hook is where anyone would notice: while a timeout reported
        # SKIP, the hook printed nothing and `check` exited 0, so a check that timed out
        # on every run was a permanent silent pass (44, D5). The commit still proceeds --
        # one slow run is not a defect -- but the reader is told which check went unrun.
        for ln in r.stdout.splitlines():
            if "[TIME]" in ln:
                print(f"  TIMED OUT (did not run): {ln.strip()}", file=sys.stderr)
    print(f"hook: harness check {time.time() - t0:.2f}s", file=sys.stderr)

    # Regenerate pod manifest from staged content so it matches HEAD after commit.
    # Run the STAGED pod_drift.py (git show :path), never the working-tree copy:
    # a hook that executes uncommitted code is the fingerprint rule turned against us
    # (2026-08-31: an uncommitted 3-column format wrote a manifest the pod's parser
    # could not read, 147 false "missing", held a launch).
    # The staged copy is written inside the repo so its ROOT (__file__-relative) resolves.
    t0 = time.time()
    repo = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    ).stdout.strip()
    if repo:
        staged_py = subprocess.run(
            ["git", "show", ":scripts/pod_drift.py"], capture_output=True
        )
        if staged_py.returncode != 0:
            staged_py = subprocess.run(
                ["git", "show", "HEAD:scripts/pod_drift.py"], capture_output=True
            )
        if staged_py.returncode == 0:
            # NOT in scripts/: restartability_audit.py scans that directory, so a
            # concurrent commit sees this temp file, finds a .py absent from its
            # baseline, and FAILs with "[NEW] scripts/.pod_drift_staged.py" -- a file
            # that is gone by the time anyone looks. Cleanup here was never the
            # problem; the location was. Same lesson as the holdout slice sitting in
            # the corpus dir: correct artifact, wrong directory, and the reader
            # downstream cannot tell it from real content.
            tmp_py = os.path.join(
                subprocess.run(["git", "-C", repo, "rev-parse", "--git-path",
                                "pod_drift_staged.py"],
                               capture_output=True, text=True).stdout.strip()
                or os.path.join(repo, ".git", "pod_drift_staged.py"))
            try:
                with open(tmp_py, "wb") as f:
                    f.write(staged_py.stdout)
                # POD_DRIFT_ROOT: in a linked worktree tmp_py lives under
                # <common>.git/worktrees/<name>/, so pod_drift's __file__-relative
                # ROOT resolves to <common>.git/worktrees and the manifest is written
                # to a phantom path while this hook's check below reads the
                # unregenerated worktree manifest -- a false refusal on any commit
                # that deletes a scoped file (measured 2026-09-02, 44-15). Pass the
                # real root explicitly.
                # Arm the restore BEFORE the write, so a pod_drift that dies after
                # opening the file is covered too -- that failure is deliberately not
                # fatal here, so its half-written residue would otherwise outlive an
                # error nobody was told about.
                _MANIFEST_RESTORE["repo"] = repo
                r = subprocess.run(
                    [sys.executable, tmp_py, "--write-index"],
                    capture_output=True, text=True,
                    env={**os.environ, "POD_DRIFT_ROOT": repo},
                )
                if r.returncode == 0:
                    # Consistency: every manifest path must resolve in the index
                    # this commit is built from. In a shared tree the working index
                    # holds everyone's staged paths; GIT_INDEX_FILE (set by git for
                    # `git commit <paths>`) is the commit's actual index.
                    manifest = os.path.join(repo, "data", "pod_head_manifest.txt")
                    if os.path.exists(manifest):
                        bad = []
                        for line in open(manifest):
                            parts = line.strip().split("  ", 2)
                            if len(parts) >= 2:
                                p = parts[1]
                                chk = subprocess.run(
                                    ["git", "show", f":{p}"], capture_output=True,
                                )
                                if chk.returncode != 0:
                                    bad.append(p)
                        if bad:
                            print(f"REFUSING: manifest names path(s) not in this commit's index: {bad[:5]}",
                                  file=sys.stderr)
                            sys.exit(1)
                    subprocess.run(["git", "add", "data/pod_head_manifest.txt"], capture_output=True)
            finally:
                if os.path.exists(tmp_py):
                    os.unlink(tmp_py)
        # If neither staged nor HEAD has pod_drift.py (fresh temp repo), skip
        # manifest regeneration -- the hook must not fail a commit it cannot serve.
    print(f"hook: manifest regen {time.time() - t0:.2f}s", file=sys.stderr)
    # THE LAST LINE OF main() IS THE DISARM, and it has to be here rather than beside the
    # `git add` that stages the manifest. Staging is not approval: a gate that refuses
    # after the manifest stage still aborts the commit, and a guard disarmed at the `git
    # add` is already down by then -- world 10 measured exactly that and stayed red under
    # my first atexit draft. Reaching this line is the only thing that means every gate
    # passed, so it is the only safe place to stop guarding.
    _MANIFEST_RESTORE.pop("repo", None)
    print(f"hook: total {time.time() - t_start:.2f}s", file=sys.stderr)


def _selftest():
    """Prove the integration-tree guard both fires and lets a merge through.

    Runs with every GIT_* variable removed from the environment first. git exports
    GIT_DIR (on merge) and GIT_INDEX_FILE to hooks, and a `git init` in a temp
    directory that inherits GIT_DIR re-initialises the SHARED repo instead: core.bare
    flipped to true and the fixture f.txt landed in the real index, twice on
    2026-09-02 (02:49Z and 04:4xZ), taking every session's git down until someone
    unset it. pod_drift.py:61 recorded the mechanism a day earlier, inside one script.

    Two worlds, and the second is the one that mattered: on 2026-09-02 `git merge
    --no-edit e1` on main was REFUSED and left a half-finished merge in the shared
    tree, because git calls this script as pre-merge-commit BEFORE writing
    MERGE_HEAD. Testing only "a plain commit on main is refused" passes on the
    broken version, which is why that version shipped.

    Runs the real hook as a subprocess in a temp repo whose path is declared the
    integration tree, so the guard is live rather than simulated.

    EVERY git call here strips the caller's git environment. The hook runs with GIT_DIR
    set to the committing worktree's gitdir, and `git init` in a fresh directory with
    GIT_DIR inherited reconfigures the SHARED repo instead -- it sets core.bare=true,
    which breaks every git command for every session until someone unsets it. I did
    exactly that at 02:49Z on 2026-09-02 and blocked main for two minutes; the mechanism
    was already written down in pod_drift.py:61-66 and I did not apply it. Reproduced
    since: GIT_DIR must point at a WORKTREE gitdir (.git/worktrees/<name>) for the bare
    flag to be set -- a plain repo's GIT_DIR does not do it, which is why a casual test
    of this looks safe, and why the destructive form only appears from a worktree, where
    every session except the controller works.
    """
    for k in [k for k in os.environ if k.startswith("GIT_")]:
        os.environ.pop(k)

    hook = os.path.realpath(__file__)
    fails = []
    # os.environ is already GIT_*-free four lines up, so `clean` is it. Named anyway,
    # because every git call below reads as deliberate rather than as inheriting
    # whatever the caller held -- and the seven-name list this replaced was narrower
    # than the prefix sweep for no reason.
    clean = dict(os.environ)

    def run(cwd, argv0, env_extra):
        dst = os.path.join(cwd, argv0)
        shutil.copyfile(hook, dst)
        os.chmod(dst, 0o755)
        env = dict(clean, AUPAI_INTEGRATION_TREE=cwd)
        env.pop("AUPAI_CONTROLLER", None)
        env.update(env_extra)
        r = subprocess.run([sys.executable, dst], cwd=cwd, capture_output=True,
                           text=True, env=env)
        return r.returncode, r.stdout + r.stderr

    d = tempfile.mkdtemp()
    try:
        for a in (["init", "-q", "-b", "main", "."], ["config", "user.email", "t@t"],
                  ["config", "user.name", "t"]):
            subprocess.run(["git"] + a, cwd=d, capture_output=True, env=clean)
        with open(os.path.join(d, "f.txt"), "w") as fh:
            fh.write("base\n")
        subprocess.run(["git", "add", "f.txt"], cwd=d, capture_output=True, env=clean)
        subprocess.run(["git", "commit", "-q", "-m", "base"], cwd=d, capture_output=True,
                       env=clean)

        # WORLD 1 (must REFUSE): an ordinary commit in the integration tree on main.
        rc, out = run(d, "pre-commit", {})
        if rc == 0 or "REFUSING: this is the integration tree" not in out:
            fails.append(f"world 1: a plain commit on main was NOT refused (rc={rc})")

        # WORLD 2 (must PASS): the same script invoked the way `git merge` invokes it.
        # No MERGE_HEAD on disk -- that is exactly the state the old code got wrong.
        if os.path.exists(os.path.join(d, ".git", "MERGE_HEAD")):
            fails.append("world 2 precondition: MERGE_HEAD exists, so it proves nothing")
        rc, out = run(d, "pre-merge-commit", {})
        if "REFUSING: this is the integration tree" in out:
            fails.append("world 2: a merge was refused in the integration tree "
                         "(pre-merge-commit with no MERGE_HEAD yet)")

        # WORLD 3 (must PASS): finishing a CONFLICTED merge, where MERGE_HEAD is on disk.
        with open(os.path.join(d, ".git", "MERGE_HEAD"), "w") as fh:
            fh.write("0" * 40 + "\n")
        rc, out = run(d, "pre-commit", {})
        if "REFUSING: this is the integration tree" in out:
            fails.append("world 3: the commit that resolves a conflicted merge was refused")
        os.unlink(os.path.join(d, ".git", "MERGE_HEAD"))

        # WORLD 4 (must PASS): reflog action says merge, name and MERGE_HEAD say nothing.
        rc, out = run(d, "pre-commit", {"GIT_REFLOG_ACTION": "merge e1"})
        if "REFUSING: this is the integration tree" in out:
            fails.append("world 4: GIT_REFLOG_ACTION=merge was refused")
    finally:
        shutil.rmtree(d, ignore_errors=True)

    # WORLD 5 (must PASS): the OTHER gate. A real linked worktree, diverged from main,
    # merging main in -- which is what the behind-main refusal tells you to do. Needs a
    # true merge, not a fast-forward: a fast-forward runs no hook, which is how this
    # stayed hidden. Kept separate because it needs a worktree, not just a repo.
    d2 = tempfile.mkdtemp()
    try:
        def git(*a, cwd=d2):
            return subprocess.run(["git"] + list(a), cwd=cwd, capture_output=True,
                                  text=True, env=clean)
        for a in (("init", "-q", "-b", "main", "."), ("config", "user.email", "t@t"),
                  ("config", "user.name", "t")):
            git(*a)
        with open(os.path.join(d2, "f.txt"), "w") as fh:
            fh.write("base\n")
        git("add", "f.txt")
        git("commit", "-q", "-m", "base")
        git("branch", "-q", "feat")
        with open(os.path.join(d2, "m.txt"), "w") as fh:
            fh.write("m\n")
        git("add", "m.txt")
        git("commit", "-q", "-m", "main-ahead")
        wt = os.path.join(d2, "wt")
        git("worktree", "add", "-q", wt, "feat")
        hooks = os.path.join(d2, ".git", "hooks")
        os.makedirs(hooks, exist_ok=True)
        for name in ("pre-commit", "pre-merge-commit"):
            dst = os.path.join(hooks, name)
            if os.path.exists(dst):
                os.unlink(dst)
            shutil.copyfile(hook, dst)
            os.chmod(dst, 0o755)
        with open(os.path.join(wt, "d.txt"), "w") as fh:
            fh.write("d\n")
        git("add", "d.txt", cwd=wt)
        env = dict(clean, AUPAI_BEHIND_MAIN_OK="1")
        subprocess.run(["git", "commit", "-q", "-m", "feat"], cwd=wt,
                       capture_output=True, env=env)
        behind = git("rev-list", "--count", "HEAD..main", cwd=wt).stdout.strip()
        r = subprocess.run(["git", "merge", "--no-edit", "main"], cwd=wt,
                           capture_output=True, text=True,
                           env={k: v for k, v in clean.items()
                                if k != "AUPAI_BEHIND_MAIN_OK"})
        out = r.stdout + r.stderr
        if behind == "0":
            fails.append("world 5 precondition: worktree is not behind, proves nothing")
        if "REFUSING: this tree is" in out:
            fails.append("world 5: `git merge --no-edit main` was refused in a worktree "
                         f"{behind} behind main -- the command the refusal itself prints")
    finally:
        shutil.rmtree(d2, ignore_errors=True)

    # WORLD 6 (must DETECT): _shared_repo_state notices a selftest that wrote to the
    # shared repo, which is the e1-14 detector. Built from the real leak: a fake
    # selftest that runs `git init` with GIT_DIR pointing at a WORKTREE gitdir, the
    # only form that flips core.bare. Everything happens inside a throwaway repo --
    # reproducing a destructive defect against the real one is how it got loose twice.
    d3 = tempfile.mkdtemp()
    try:
        def g3(*a, cwd=d3):
            return subprocess.run(["git"] + list(a), cwd=cwd, capture_output=True,
                                  text=True, env=clean)
        for a in (("init", "-q", "-b", "main", "."), ("config", "user.email", "t@t"),
                  ("config", "user.name", "t")):
            g3(*a)
        with open(os.path.join(d3, "f.txt"), "w") as fh:
            fh.write("base\n")
        g3("add", "f.txt")
        g3("commit", "-q", "-m", "base")
        g3("branch", "-q", "side")
        wt3 = os.path.join(d3, "wt")
        g3("worktree", "add", "-q", wt3, "side")
        gd = subprocess.run(["git", "rev-parse", "--absolute-git-dir"], cwd=wt3,
                            capture_output=True, text=True, env=clean).stdout.strip()

        before = _shared_repo_state(d3)
        if not before[0]:
            fails.append("world 6 precondition: no config digest, so a change cannot show")
        cfg_path = os.path.join(
            subprocess.run(["git", "-C", d3, "rev-parse", "--path-format=absolute",
                            "--git-common-dir"], capture_output=True, text=True,
                           env=clean).stdout.strip(), "config")
        with open(cfg_path, "rb") as fh:
            cfg_bytes = fh.read()
        victim = tempfile.mkdtemp()
        try:
            subprocess.run(["git", "init", "-q", victim], capture_output=True,
                           env=dict(clean, GIT_DIR=gd))
        finally:
            shutil.rmtree(victim, ignore_errors=True)
        after = _shared_repo_state(d3)
        if after == before:
            fails.append("world 6: the leak did not reproduce, so the detector is "
                         "untested -- GIT_DIR must point at a worktree gitdir")
        elif subprocess.run(["git", "-C", d3, "config", "--get", "core.bare"],
                            capture_output=True, text=True,
                            env=clean).stdout.strip() != "true":
            fails.append("world 6: config changed but core.bare is not true -- the "
                         "reproduction is not the leak we mean")
        # Restore the exact bytes, then confirm equality returns -- so a difference is
        # attributable to one selftest and not to drift. `git config --unset core.bare`
        # does NOT restore them: `git init` wrote `bare = false`, and the unset deletes
        # that line rather than putting it back, leaving a config that differs from the
        # baseline. A whole-file hash notices that; a core.bare comparison would not,
        # which is the point of hashing.
        with open(cfg_path, "wb") as fh:
            fh.write(cfg_bytes)
        if _shared_repo_state(d3) != before:
            fails.append("world 6: state did not return to baseline after restoring the "
                         "config bytes, so a difference cannot be attributed to one "
                         "selftest")
    finally:
        shutil.rmtree(d3, ignore_errors=True)

    # WORLDS 7-9 (e1-19): the manifest must not survive a refusal. b0's livelock was
    # three mutually-blocking rules, and only one of them is a bug: the hook regenerates
    # data/pod_head_manifest.txt, refuses for an unrelated reason, and LEAVES the file
    # dirty. main rewrites that file on 30 of its last 30 commits, so `git merge main`
    # then aborts with "your local changes would be overwritten" -- and the behind-main
    # gate refuses every commit until exactly that merge happens. Neither gate is wrong;
    # the residue is. World 9 is the other half of the property: a manifest the developer
    # really is committing must still land, or the fix trades a livelock for silent data
    # loss.
    d4 = tempfile.mkdtemp()
    try:
        def git4(*a, cwd=d4):
            return subprocess.run(["git"] + list(a), cwd=cwd, capture_output=True,
                                  text=True, env=clean)
        for a in (("init", "-q", "-b", "main", "."), ("config", "user.email", "t@t"),
                  ("config", "user.name", "t")):
            git4(*a)
        os.makedirs(os.path.join(d4, "data"))
        os.makedirs(os.path.join(d4, "scripts"))
        mpath = os.path.join(d4, "data", "pod_head_manifest.txt")
        with open(os.path.join(d4, "code.py"), "w") as fh:
            fh.write("x = 1\n")
        with open(mpath, "w") as fh:
            fh.write("aaa  code.py  docs\n")
        # A pod_drift stand-in: writes the manifest, and STUB_GHOST decides whether it
        # names a path absent from the index -- which is the hook's own consistency
        # refusal. Both settings are needed: worlds 7 and 8 need the refusal, world 9
        # needs the success path, and a stub that always emits the ghost makes every
        # commit through it refuse (which is how my first world 9 went red -- it was
        # asserting the success path in a world that could not have one). The real
        # pod_drift needs the whole repo; what is under test is the hook's cleanup.
        with open(os.path.join(d4, "scripts", "pod_drift.py"), "w") as fh:
            fh.write(
                "import os, sys\n"
                "ROOT = os.environ.get('POD_DRIFT_ROOT') or os.path.dirname(\n"
                "    os.path.dirname(os.path.abspath(__file__)))\n"
                "if '--write-index' in sys.argv:\n"
                "    rows = 'ZZZ  code.py  docs\\n'\n"
                "    if os.environ.get('STUB_GHOST') == '1':\n"
                "        rows += 'ZZZ  ghost_absent_from_index.py  docs\\n'\n"
                "    open(os.path.join(ROOT, 'data', 'pod_head_manifest.txt'), 'w').write(rows)\n"
                "    sys.exit(int(os.environ.get('STUB_RC', '0')))\n")
        git4("add", "-A")
        git4("commit", "-q", "-m", "base")
        head_bytes = open(mpath, "rb").read()
        hooks4 = os.path.join(d4, ".git", "hooks")
        os.makedirs(hooks4, exist_ok=True)
        shutil.copyfile(hook, os.path.join(hooks4, "pre-commit"))
        os.chmod(os.path.join(hooks4, "pre-commit"), 0o755)

        # WORLD 7 (must REFUSE and leave no residue).
        with open(os.path.join(d4, "code.py"), "w") as fh:
            fh.write("x = 2\n")
        git4("add", "code.py")
        r7 = subprocess.run(["git", "commit", "-q", "-m", "w7"], cwd=d4,
                            capture_output=True, text=True,
                            env=dict(clean, STUB_GHOST="1"))
        if "REFUSING: manifest names path" not in (r7.stdout + r7.stderr):
            fails.append("world 7 precondition: the consistency check did not refuse, so "
                         "the cleanup path never ran")
        elif open(mpath, "rb").read() != head_bytes:
            fails.append("world 7: the hook refused and left its own manifest on disk -- "
                         "`git merge main` will abort while behind-main demands it")

        # WORLD 8 (must PASS): the END-TO-END lock, with the residue produced the way it
        # is really produced -- by a refused commit, not by hand. Three earlier drafts of
        # this world were red under a correct fix, each for its own reason:
        #   wrote the residue itself    only git could satisfy that, by ignoring a dirty
        #                               file, which no hook can arrange
        #   staged code.py to trip it   behind-main refuses at stage 2, LONG before the
        #                               manifest is written at stage 7, so there was no
        #                               residue and the merge aborted on code.py -- my own
        #                               fixture's file, reported as the finding
        #   staged note.txt to trip it  the refusal leaves it staged, and a staged path is
        #                               enough to abort the merge by itself, so a pass
        #                               would not have been about the manifest
        # The trigger must therefore stage NOTHING: --allow-empty reaches the manifest
        # stage with a clean index, so the only file that can be dirty afterwards is the
        # one the hook wrote. AUPAI_BEHIND_MAIN_OK gets it past stage 2 to the stage under
        # test -- being behind main is world 8's premise, not its subject.
        git4("commit", "-q", "-m", "w8-base", "--no-verify")
        git4("branch", "-q", "feat")
        with open(os.path.join(d4, "code.py"), "w") as fh:
            fh.write("x = 3\n")
        with open(mpath, "w") as fh:
            fh.write("bbb  code.py  docs\n")  # main's churn: 30/30 commits touch it
        git4("add", "-A")
        git4("commit", "-q", "-m", "main-ahead", "--no-verify")
        git4("checkout", "-q", "feat")
        r8a = subprocess.run(["git", "commit", "-q", "--allow-empty", "-m", "w8-refused"],
                             cwd=d4, capture_output=True, text=True,
                             env=dict(clean, AUPAI_BEHIND_MAIN_OK="1",
                                      STUB_GHOST="1"))
        dirty8 = [ln[3:] for ln in git4("status", "--short").stdout.splitlines()]
        behind8 = git4("rev-list", "--count", "HEAD..main").stdout.strip()
        r8 = git4("merge", "--no-edit", "main")
        if "REFUSING: manifest names path" not in (r8a.stdout + r8a.stderr):
            fails.append("world 8 precondition: the refusal reached was not the manifest's "
                         f"own, so no residue was produced: {(r8a.stdout + r8a.stderr).strip()[:120]!r}")
        elif behind8 == "0":
            fails.append("world 8 precondition: not behind main, proves nothing")
        elif dirty8 not in ([], ["data/pod_head_manifest.txt"]):
            fails.append(f"world 8 precondition: other dirty paths {dirty8} would abort the "
                         "merge on their own, so a pass says nothing about the manifest")
        elif "would be overwritten by merge" in (r8.stdout + r8.stderr):
            fails.append("world 8: after a refused commit, `git merge main` aborts on the "
                         "manifest the hook itself wrote -- the livelock is open")

        # WORLD 9 (must NOT restore): a manifest the developer staged deliberately must
        # reach the commit. The cleanup above is unconditional on the refusal paths, so
        # this is the assertion that it never fires on the success path.
        git4("checkout", "-q", "-f", "main")
        with open(mpath, "w") as fh:
            fh.write("ddd  code.py  docs\n")
        git4("add", "data/pod_head_manifest.txt")
        env9 = dict(clean, STUB_RC="0", STUB_GHOST="0")
        subprocess.run(["git", "commit", "-q", "-m", "w9"], cwd=d4,
                       capture_output=True, text=True, env=env9)
        got9 = git4("show", "HEAD:data/pod_head_manifest.txt").stdout
        if "ddd" not in got9 and "ZZZ" not in got9:
            fails.append("world 9: a deliberately staged manifest reached neither the "
                         f"commit nor regeneration (HEAD holds {got9.strip()!r}) -- the "
                         "cleanup fires on the success path and eats real content")
    finally:
        shutil.rmtree(d4, ignore_errors=True)

    # WORLD 10 (must PASS): a gate added AFTER the manifest stage must not reopen the
    # livelock. Worlds 7-9 pass under a restore that is merely positional -- calling
    # _restore_manifest at each refusal below the write -- because the manifest stage
    # happens to be the LAST stage today, so those are all the exits there are. That is
    # what 3f5231c shipped, and it was accidentally complete, not complete.
    #
    # This world is the only one that separates the two designs, and it needs a MUTATED
    # copy of the hook: the future gate does not exist yet, so the world has to add it.
    # Copying the hook and appending a refusal after the last stage is the smallest thing
    # that asks the real question -- would the next person to add a gate reintroduce b0's
    # three-way lock without touching the manifest code at all. Measured before the fix:
    # ' M data/pod_head_manifest.txt' came straight back. atexit passes because the
    # cleanup is armed at the write and disarmed at the `git add`, so it covers every exit
    # between them, including ones nobody has written yet.
    d5 = tempfile.mkdtemp()
    try:
        def git5(*a, cwd=d5):
            return subprocess.run(["git"] + list(a), cwd=cwd, capture_output=True,
                                  text=True, env=clean)
        for a in (("init", "-q", "-b", "main", "."), ("config", "user.email", "t@t"),
                  ("config", "user.name", "t")):
            git5(*a)
        os.makedirs(os.path.join(d5, "data"))
        os.makedirs(os.path.join(d5, "scripts"))
        m5 = os.path.join(d5, "data", "pod_head_manifest.txt")
        with open(os.path.join(d5, "code.py"), "w") as fh:
            fh.write("x = 1\n")
        with open(m5, "w") as fh:
            fh.write("aaa  code.py  docs\n")
        with open(os.path.join(d5, "scripts", "pod_drift.py"), "w") as fh:
            fh.write(
                "import os, sys\n"
                "ROOT = os.environ.get('POD_DRIFT_ROOT') or os.path.dirname(\n"
                "    os.path.dirname(os.path.abspath(__file__)))\n"
                "if '--write-index' in sys.argv:\n"
                "    open(os.path.join(ROOT, 'data', 'pod_head_manifest.txt'), 'w').write(\n"
                "        'ZZZ  code.py  docs\\n')\n")
        git5("add", "-A")
        git5("commit", "-q", "-m", "base")
        head5 = open(m5, "rb").read()
        with open(hook, encoding="utf-8") as fh:
            src5 = fh.read()
        # Inject the future gate at the DISARM, not at the "hook: total" line. Those are
        # adjacent, and the difference decides what this world measures: a gate added
        # after the disarm is by construction outside the guarded region, so anchoring
        # there tests the fixture rather than the design. A real gate goes where every
        # other gate goes -- above the point that means "the hook approved this commit".
        anchor = '    _MANIFEST_RESTORE.pop("repo", None)\n'
        hooks5 = os.path.join(d5, ".git", "hooks")
        os.makedirs(hooks5, exist_ok=True)
        if src5.count(anchor) != 1:
            fails.append("world 10 precondition: could not locate the single disarm line "
                         "to add a gate above, so the future-gate case is untested")
        else:
            dst5 = os.path.join(hooks5, "pre-commit")
            with open(dst5, "w", encoding="utf-8") as fh:
                fh.write(src5.replace(
                    anchor,
                    '    print("REFUSING: a gate added after the manifest stage",\n'
                    '          file=sys.stderr)\n'
                    '    sys.exit(1)\n' + anchor, 1))
            os.chmod(dst5, 0o755)
            with open(os.path.join(d5, "code.py"), "w") as fh:
                fh.write("x = 2\n")
            git5("add", "code.py")
            r10 = subprocess.run(["git", "commit", "-q", "-m", "w10"], cwd=d5,
                                 capture_output=True, text=True, env=clean)
            if "REFUSING: a gate added after the manifest stage" not in (r10.stdout + r10.stderr):
                fails.append("world 10 precondition: the appended gate did not refuse, so "
                             "nothing was tested")
            elif open(m5, "rb").read() != head5:
                fails.append("world 10: a gate added after the manifest stage leaves the "
                             "residue behind -- the cleanup is positional, so the next "
                             "person to add a gate reopens the livelock")
    finally:
        shutil.rmtree(d5, ignore_errors=True)

    for f in fails:
        print("SELFTEST FAIL: " + f, file=sys.stderr)
    print("pre-commit selftest: %s (10 worlds)" % ("FAIL" if fails else "ok"),
          file=sys.stderr)
    return 1 if fails else 0


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        sys.exit(_selftest())
    main()
