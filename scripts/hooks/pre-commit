#!/usr/bin/env python3
"""Pre-commit hook: refuse oversized blobs and unlisted data/ paths; keep pod
manifest fresh from the index.

Install: python scripts/harness.py install-hooks
Bypass: git commit --no-verify (use only for a legitimate new data file,
and say why in the commit message).

The 5MB limit is the same as harness's no_oversized_blob check -- this hook
is the first line (commit time), CI is the second. The data/ allow-list is
the set of paths that may be committed; anything else under data/ is refused
because large data belongs in .gitignore, not history (d535674 swept 234MB
under data/_corpus_unsanitized/ into one commit).

This hook no longer touches data/pod_head_manifest.txt: it is untracked, and
scripts/pod_push.sh generates it from the HEAD it ships (shape A, 2026-09-04).
Regenerating a derived file on every commit made it the top friction cause, and
in a merge commit the regen ran after git had built the tree, so it could only
ever land in the index -- permanently dirty, aborting the next merge.
"""
import ast
import fnmatch
import glob
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import tempfile

MAX = 5 * 1024 * 1024

ALLOWED = [
    "data/mix_*.json",
    "data/token_cache_pools.json",
    "data/eval/*",
    "data/synthetic/*",
    "data/corpus/sample/*",
    "data/corpus/.counts.json",
    "data/PROVENANCE.md",
    "data/MANIFEST.tsv",
    "data/env_fp_baseline.json",
    "data/train_cite_baseline.json",
    "data/raw/*_manifest.txt",
    "data/sft/*.py",
    "data/t2s_table.json",
    "data/REBUILD_PLAN_*.md",
    "data/rl/*",
    "data/rl_tasks/*",
    "data/sft_contamination_baseline.json",
    # The row schemas for runs/*.jsonl ledgers. Text, kilobytes, and read by the writers
    # that validate against it -- the opposite of the 234 MB corpus blob this list exists
    # to keep out.
    "data/ledger_schema.json",
    "data/ledger_transport_schema.json",
    # Probe item files. Items are drawn FROM the training corpus, so they must stay
    # OUT of data/eval/ -- everything under that prefix has to be in datagen/holdout.py
    # REGISTRY, and registering these would EXCLUDE them from the corpus, inverting the
    # purpose of the probe. Under MAX, one row per line, and read by eval/*.py.
    # fnmatch's `*` crosses `/`, so this also admits data/probes/novel_ops/*.jsonl, the
    # constructed-operator curve sets (3.4 MB, tracked so a scored curve is re-derivable
    # by someone who did not run the emitter). A second pattern for them was added and
    # removed on 2026-09-05: it matched nothing this one did not.
    "data/probes/*.jsonl",
]


def repo_root():
    return subprocess.run(["git", "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True).stdout.strip()


def _registered_selftest_paths():
    """The repo-relative paths in this file's own SELFTEST_FILES literal, read with `ast`.

    Read from source because SELFTEST_FILES is a LOCAL inside main(), defined ~400 lines after the
    stale-copy sweep that needs it. The sweep has to run before any refusal can return -- that is
    the whole point of its position -- so it cannot wait for a name bound later in the same function.

    `ast.literal_eval` on the assignment node, not a regex over the text. Two regex versions were
    written and both were wrong in opposite directions, which is the argument for the parser:

      matching every quoted .py in the region      -> 182 paths, including
                                                      "HEAD:scripts/credential_scan.py" from a git
                                                      revspec in a comment
      requiring exactly one quoted path per line   -> 149 of 177, because the map packs several
                                                      entries onto one line

    Neither error announced itself; both counts looked plausible. ast reads the literal python builds,
    so it cannot disagree with the map by construction -- verified against the ast of the same file:
    177 == 177, nothing missing, nothing extra.

    Returns the empty set on any failure, and the sweep then degrades to the repo root -- where a copy
    of a root-level selftest file lands anyway.
    """
    try:
        tree = ast.parse(open(__file__, encoding="utf-8").read())
    except (OSError, SyntaxError):
        return set()
    for node in ast.walk(tree):
        if not isinstance(node, ast.Assign):
            continue
        for t in node.targets:
            if isinstance(t, ast.Name) and t.id == "SELFTEST_FILES":
                try:
                    return {x for x in ast.literal_eval(node.value) if isinstance(x, str)}
                except ValueError:
                    return set()
    return set()


def _behind_main():
    """How many commits main has that this tree does not. 0 on main itself, and 0
    when the count cannot be taken -- a tree with no main (a fresh temp repo, a
    clone of one branch) must not be refused for a question that has no answer."""
    r = subprocess.run(["git", "rev-list", "--count", "HEAD..main"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return 0
    try:
        return int(r.stdout.strip())
    except ValueError:
        return 0


def _merging(common_abs=None):
    """Is this invocation part of a merge? Three signals, because each is absent in
    some real case and MERGE_HEAD alone was wrong in BOTH gates below.

    git runs this one file under two names. `git commit` (finishing a CONFLICTED
    merge) sees MERGE_HEAD already on disk. `git merge` does not call pre-commit at
    all -- it calls pre-merge-commit, symlinked here by cmd_install_hooks -- and on a
    CLEAN merge it calls it BEFORE MERGE_HEAD is written. So a clean merge looks like
    no merge, and both exemptions below silently failed on it:

      integration tree   `git merge --no-edit e1` on main was refused and left a
                         half-finished merge in the shared tree (2026-09-02)
      behind main        `git merge --no-edit main` in a diverged worktree was
                         refused -- the exact command its own message tells you to
                         run (measured 2026-09-02, a true merge, not a fast-forward)

    Both were tested by resolving a CONFLICT, where MERGE_HEAD does exist, so both
    read green. A fast-forward runs no hook at all, which is why the everyday case
    hid it too.

    --git-path resolves MERGE_HEAD per worktree (.git/worktrees/<name>/), which the
    common dir does not; pass common_abs to also accept the integration tree's own
    .git, where the tree check knows the common dir IS .git.
    """
    if common_abs and os.path.exists(os.path.join(common_abs, "MERGE_HEAD")):
        return True
    p = subprocess.run(["git", "rev-parse", "--git-path", "MERGE_HEAD"],
                       capture_output=True, text=True).stdout.strip()
    if p and os.path.exists(p):
        return True
    return (os.path.basename(sys.argv[0]) == "pre-merge-commit"
            or os.environ.get("GIT_REFLOG_ACTION", "").startswith("merge"))


def _union_merged(paths):
    """Which of `paths` git merges WITHOUT a human -- merge=union or a named driver.

    THE ATTRIBUTE IS THE AUTHORITY, not a list here. .gitattributes already names the
    append-only ledgers and a second copy of that list in this file would rot against it --
    the fix would then be to add a ledger in one place and have the other silently disagree,
    which is the shape half this hook exists to catch. Reads the resolved attribute, so a
    ledger added to .gitattributes is covered the moment it is added.

    ANY DRIVER COUNTS, NOT ONLY `union` (2026-09-06, b0's deadlock). The exemption asks "can
    this file be merged without a person?", and `union` was the only answer that existed when
    it was written. runs/prereg.jsonl is amended in place -- one row per id -- so union is
    wrong for it and it was left unspecified, which put it outside the exemption and produced
    a state with no legal move: `git merge` refuses while the file is dirty ("commit or stash
    them"), this hook refuses the commit that would satisfy it, and git stash is forbidden
    because .git/refs/stash is shared. Both rules were right and their intersection was empty.
    prereg.jsonl now has merge=prereg-union (scripts/prereg_merge.py), which resolves it by
    key, so it belongs in the exemption for the same reason the union ledgers do.

    `unspecified` and `unset` stay excluded: those are the files where a merge needs a person,
    which is exactly who the behind-main refusal is for.
    """
    if not paths:
        return set()
    r = subprocess.run(["git", "check-attr", "merge", "--"] + list(paths),
                       capture_output=True, text=True)
    out = set()
    for line in r.stdout.splitlines():
        # "<path>: merge: union". Split from the RIGHT twice: a path may contain ": ", and
        # the value never does.
        rest, _, value = line.rpartition(": ")
        if value.strip() in ("unspecified", "unset", "set", ""):
            continue
        path, _, attr = rest.rpartition(": ")
        if attr == "merge" and path:
            out.add(path)
    return out


def _main_touched_staged(paths):
    """Of `paths`, the ones main has CHANGED since this branch diverged. [] when unknowable.

    THE COUNT WAS THE WRONG PREDICATE. "N commits behind" refuses whenever main moved at
    all, and on a repo with six sessions main moves during the merge you were told to run:
    b0 was refused at 15 behind, merged, and was refused again at 4 behind. Measured
    2026-09-06: 80 of 174 friction rows carry AUPAI_BEHIND_MAIN_OK, 35 of 51 dated 09-06.

    The refusal's own stated reason is "this commit writes on top of code main has already
    moved past". That reason is about the FILES, not the commit count -- if main advanced
    only on files this commit does not stage, nothing it writes lands on top of anything.
    So the predicate is the intersection, and it goes empty on its own as soon as the merge
    that matters is done, which is what makes the wall passable.

    THREE-DOT, NOT TWO. `git diff <base> main` where base is the merge-base is what "main
    changed since we diverged" means. Using HEAD..main's endpoints directly would also list
    files THIS branch changed, refusing a commit because of its own edits.
    """
    if not paths:
        return []
    base = subprocess.run(["git", "merge-base", "HEAD", "main"], capture_output=True, text=True)
    if base.returncode != 0 or not base.stdout.strip():
        return []  # no main, or no common ancestor: a question with no answer refuses nothing
    r = subprocess.run(["git", "diff", "--name-only", base.stdout.strip(), "main"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return []
    return sorted(set(r.stdout.split("\n")) & set(paths) - {""})


def staged(diff_filter):
    r = subprocess.run(
        ["git", "diff", "--cached", "--name-only", f"--diff-filter={diff_filter}"],
        capture_output=True, text=True,
    )
    return [f for f in r.stdout.splitlines() if f.strip()]


def _config_sections(raw):
    """[(header, body)] for an INI file: a section is its header line plus every line until
    the next header. Used to hash part of a config rather than all of it."""
    out, header, body = [], "", []
    for line in raw.decode("utf-8", "replace").splitlines(True):
        if line.lstrip().startswith("["):
            if header or body:
                out.append((header, "".join(body)))
            header, body = line.strip(), []
        else:
            body.append(line)
    if header or body:
        out.append((header, "".join(body)))
    return out


def _shared_repo_state(root):
    """(sha256 of the shared .git/config EXCEPT its [branch] sections, staged paths, branch
    section names) -- what a selftest must not change.

    Stripping GIT_* from the child stops the leak we know about (e1-12). This measures
    the property instead of the mechanism: whatever a selftest does, the shared repo must
    look the same afterwards. Two cheap reads, ~10ms.

    HASH THE FILE, do not enumerate fields (b0's correction, 2026-09-02). The first
    version compared core.bare, because that is the field that broke us -- but `git init`
    under a leaked GIT_DIR rewrites the entire config, and core.bare is merely the most
    lethal line in it. A field list only catches the forms already imagined; the next leak
    adds a remote or bumps repositoryformatversion and passes.

    [branch] SECTIONS ARE EXCLUDED, and that exclusion is the whole difference between a
    guard and a lottery. `git push -u` writes `[branch "<name>"] remote/merge` into the
    SHARED config; six sessions open PRs continuously, so that writer is normal work and
    cannot be paused. Every selftest the hook runs is one more collision window, and there
    are about forty of them. What it cost, both measured 2026-09-08: b0 refused five times
    with a different digest each time (3cfc2d49, cbf3cc0c, 33df6b01 among them), e1 four
    times, each refusal naming a DIFFERENT innocent file. Nine refusals, nine wrong names.

    WHAT WOULD MAKE THIS EXCLUSION WRONG, stated so the next person to widen it knows what
    to falsify: it rests on the claim that the only writers of [branch] sections are
    `git push -u` and a human `git config`. b0 measured the half that is easy to get
    backwards -- creating a branch locally writes nothing to the shared config. If a
    SELFTEST is ever found writing a [branch] section, that selftest has the bug; the
    answer is still not to widen the digest, because widening it restores the livelock.
    A leaked `git init` rewrites core.*, remote.* and repositoryformatversion, all still
    hashed, so the destructive form this guard exists for is untouched.

    The branch NAMES come back as the third element so a refusal can say which direction
    they moved, because direction is the one observation that separates the innocent causes:
    a gain is a push, a loss is a branch or worktree being pruned. It is deliberately NOT
    part of the equality -- see _shared_repo_changed. b0 read the old hint ("same value
    every run is a selftest, a different value each time is a peer") and reached a
    confident, specific, wrong conclusion, because neither tell distinguishes a gain from
    a loss: the evidence was in b0's own paste, a branch count of 84 -> 81, and a drop
    rules a push OUT.

    The leak needs GIT_DIR pointing at a WORKTREE gitdir (.git/worktrees/<name>) -- a
    plain repo's GIT_DIR does not flip core.bare, so a casual test looks safe and only a
    worktree, where every session but the controller works, produces the destructive form.
    Twice on 2026-09-02: a bare flag at 02:49Z (a report at 02:50:39Z records it) and a
    second write at 02:51:08Z while the first was being reproduced. Each took every
    session's git down until someone unset it.

    The first of those was reported as "probably some automation" 45 seconds after the
    reporter had landed a selftest that runs `git init`. The error was the ORDER of
    investigation, not the guess: an external cause is easier to assume and harder to
    refute, while "what did I change in the last 60 seconds" is the one thing you can
    always get evidence for. This check exists so the answer arrives without anyone
    having to ask the question.
    """
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    # --path-format=absolute, not bare --git-common-dir: that returns ".git", relative to
    # the REPO, and realpath resolves it against the caller's cwd instead -- so the digest
    # came back empty from anywhere but the repo root and world 6 reported "no config
    # digest". An empty digest compares equal to an empty digest, so the detector would
    # have passed everything while measuring nothing.
    cfg = subprocess.run(["git", "-C", root, "rev-parse", "--path-format=absolute",
                          "--git-common-dir"],
                         capture_output=True, text=True, env=env).stdout.strip()
    digest, branches = "", frozenset()
    if cfg:
        path = os.path.join(cfg, "config")
        if os.path.exists(path):
            with open(path, "rb") as fh:
                raw = fh.read()
            secs = _config_sections(raw)
            branches = frozenset(h for h, _ in secs if h.startswith('[branch "'))
            kept = "".join(h + "\n" + b for h, b in secs if not h.startswith('[branch "'))
            digest = hashlib.sha256(kept.encode("utf-8")).hexdigest()[:16]
    idx = subprocess.run(["git", "-C", root, "diff", "--cached", "--name-only"],
                         capture_output=True, text=True, env=env).stdout.split()
    return digest, frozenset(idx), branches


def _shared_repo_changed(before, after):
    """What changed between two _shared_repo_state reads, as a list of observations.

    Empty means nothing a selftest is answerable for. Branch sections are reported when
    something else already changed, and never on their own: they are the thing six
    concurrent pushes write, and charging a selftest for them is what produced five
    false refusals across two sessions on 2026-09-08.
    """
    what = []
    if after[0] != before[0]:
        what.append(f".git/config changed outside its [branch] sections "
                    f"({before[0]} -> {after[0]})")
    gained, lost = after[1] - before[1], before[1] - after[1]
    if gained:
        what.append(f"staged {sorted(gained)[:4]}")
    if lost:
        what.append(f"unstaged {sorted(lost)[:4]}")
    if what:
        b_add, b_del = len(after[2] - before[2]), len(before[2] - after[2])
        if b_add or b_del:
            what.append(f"and, separately, [branch] sections {len(before[2])} -> "
                        f"{len(after[2])} (+{b_add}/-{b_del}); a gain is someone's "
                        f"`git push -u`, a loss is a branch or worktree being pruned")
    return what


def _refuse_committing_on_main(merging):
    """Refuse a commit whose HEAD is the branch `main`. Nobody's session branch is main.

    2026-09-08, 05:40:09Z: b0 committed 484a9528 onto refs/heads/main from aupai-b0, which had
    main checked out. At 05:45:45 they ran `branch: Reset to origin/main`, and main moved off
    that commit -- a sideways move, caught by main_advances_by_ancestry, which then refused every
    commit repo-wide until PR #54 recorded the pair. Nothing was lost only because b0 created
    refs/heads/b0 from HEAD in the same second (both reflog entries read 05:45:45), so the rescue
    was an act rather than a safety net.

    THE PREDICATE IS "HEAD IS main", NOT "main != origin/main". 4c's proposal was the latter, and
    it would NOT have fired: at 05:40:09 local main was 7049750c and origin/main had been pushed
    to 7049750c at 05:39:05, so the two were EQUAL and the divergence was created BY the commit
    this hook runs before. A predicate reading the state the commit produces cannot see the commit
    that produces it. Checking HEAD's branch instead fires before the first such commit exists,
    which is the whole point of a pre-commit gate.

    This is main_in_no_worktree's hazard at the write. That check (WARN, harness) sees the state
    statically and asks another session to fix their own tree; this refuses the act that turns the
    state into a loss. Neither replaces the other: a tree can hold main checked out for hours
    harmlessly, and a commit here is wrong the first time.

    `symbolic-ref --short -q HEAD` and not `rev-parse --abbrev-ref HEAD`, and the reason is NOT
    the one this docstring first gave. It claimed abbrev-ref's literal "HEAD" when detached was a
    string a name test could match; measured, both refuse identically there, because "HEAD" !=
    "main" and the gate returns. A mutation sweep swapping the two commands SURVIVED every world
    until an UNBORN HEAD was added -- `git init` with no commit yet, where abbrev-ref exits 128 and
    prints "HEAD" (so the mutant returns early and PERMITS the commit) while symbolic-ref exits 0
    and correctly answers "main". That is the repo's very first commit, made on main, which is the
    one commit this gate most needs to catch. The right justification is that symbolic-ref reads
    the ref HEAD points at, which exists before any commit does; rev-parse resolves HEAD to an
    object, which does not.

    Exempt while merging: `merge_main.sh` never checks main out, but a session resolving a
    conflict on a branch that legitimately tracks main must be able to finish. Silent when git
    cannot answer -- a tree with no HEAD is not a tree committing on main.
    """
    if merging:
        return
    r = subprocess.run(["git", "symbolic-ref", "--short", "-q", "HEAD"],
                       capture_output=True, text=True)
    if r.returncode != 0 or r.stdout.strip() != "main":
        return
    print(
        "REFUSING: HEAD is the branch `main`, so this commit lands on main directly.\n"
        "Commit on your own branch and let merge_main advance main:\n"
        "  git branch <your-name> && git checkout <your-name>   # keeps the staged work\n"
        "  git commit <paths> -m '...'\n"
        "  scripts/merge_main.sh <your-name>\n"
        "main is advanced by an atomic update-ref compare-and-swap that touches no working "
        "tree, which is safe only while no tree holds main. A commit here also puts work on a "
        "ref every other session fast-forwards: on 2026-09-08 the next `Reset to origin/main` "
        "moved main off such a commit and the sideways move refused every commit in the "
        "repository until it was recorded by hand.\n"
        "If you are already holding work here, `git branch <name>` first -- it keeps HEAD's "
        "commit and your index, and costs nothing if you were about to be right.",
        file=sys.stderr,
    )
    sys.exit(1)


def _refuse_copied_worktree(top):
    """Refuse a commit from a COPY of a linked worktree -- it writes the original's branch.

    cf3dbaea "probe 2": a `cp -r` of a linked worktree carries its `.git` FILE, which is a one-line
    `gitdir:` pointer into .git/worktrees/<name> in the real repository. The copy therefore shares
    the original's HEAD, index and branch ref, so a commit made in /tmp/reg_moe landed on the real
    branch and merged to main carrying a SwiGLU mutant. Nothing in the copy looks wrong: status,
    log and branch all answer, correctly, about a tree the operator is not in.

    THE CRITERION IS GIT'S OWN BACK-POINTER, not a heuristic about `.git` files or /tmp paths.
    .git/worktrees/<name>/gitdir holds the absolute path of the `.git` file git expects to find
    this worktree at; git writes it at creation and rewrites it on `git worktree move`, so it is
    the repository's record rather than a guess. A copy's cwd cannot match it, and the original's
    always does. That makes the test exact in both directions and independent of where the copy
    lives or what it is called.

    Silent when the back-pointer is missing or unreadable rather than refusing: a hook that blocks
    every commit because it could not read one file is worse than the bug it guards.
    """
    gitdir = subprocess.run(["git", "rev-parse", "--git-dir"],
                            capture_output=True, text=True).stdout.strip()
    if not gitdir:
        return
    gitdir = os.path.realpath(gitdir)
    ptr = os.path.join(gitdir, "gitdir")
    if not os.path.isfile(ptr):
        return  # not a linked worktree (a normal checkout has no back-pointer), or unreadable
    try:
        expect_dotgit = open(ptr).read().strip()
    except OSError:
        return
    if not expect_dotgit:
        return
    # The back-pointer names the `.git` FILE; its parent is the worktree directory.
    registered = os.path.realpath(os.path.dirname(expect_dotgit))
    here = os.path.realpath(top)
    if registered == here:
        return
    print(
        "REFUSING: this directory is a COPY of a worktree, so a commit here writes another "
        "tree's branch.\n"
        f"  you are in:              {here}\n"
        f"  but git has {os.path.basename(gitdir)} registered at: {registered}\n"
        "A `cp -r` of a worktree copies its .git FILE, which is only a `gitdir:` pointer -- HEAD, "
        "the index and the branch ref all still belong to the original. Nothing looks wrong: "
        "status, log and branch all answer correctly about a tree you are not in. cf3dbaea landed "
        "a SwiGLU mutant on main this way.\n"
        "  To work on a separate copy of the code: git worktree add <path> -b <branch>\n"
        "  To commit to this branch: cd to the registered path above.",
        file=sys.stderr,
    )
    sys.exit(1)


def main():
    # Stage timings in the output: a hook people wait minutes for is a hook they
    # bypass (4a7dd56 --no-verify precedent, 2026-08-31).
    import time

    t_start = time.time()

    # SWEEP STALE .hookstaged_* COPIES HERE, FIRST, BEFORE ANY REFUSAL CAN RETURN.
    #
    # This sweep used to sit beside the selftest runner at the point where the copies are made,
    # which is ~1200 lines and 26 `sys.exit(1)` calls further down. Every one of those refusals --
    # behind-main, dirty index, credential scan, blob size, shared-file claim -- returns before the
    # sweep, so the cleanup only ran on a commit that had already passed every gate. That is exactly
    # backwards: the copies are left behind by a run that DIED, and the next commit attempt is the
    # one most likely to be refused for an unrelated reason and never reach the cleanup.
    #
    # MEASURED 2026-09-05: runs/audit_0904/.hookstaged_dead_worlds.py sat in the working tree for
    # hours across a dozen commits. runs/audit_0904/dead_worlds.py IS registered, so the directory
    # was in the sweep's scope and the glob was correct -- the sweep was simply never reached,
    # because every intervening commit hit the behind-main refusal first. A cleanup placed after the
    # gates cleans up only when nothing needed cleaning.
    #
    # SCOPED BY READING THE MAP OUT OF THIS FILE'S OWN SOURCE, not by using SELFTEST_FILES.
    # That name is a LOCAL defined at line ~697, four hundred lines below here, so referencing it at
    # the top of main() is an UnboundLocalError on every commit -- ruff F821 caught it, and my own
    # commits had passed because a hook edited in a branch worktree does not run until it is merged
    # (.git/hooks/pre-commit resolves against main's worktree), so every commit that "verified" the
    # hoist executed main's OLD copy of this file.
    #
    # Reading the literal is not a workaround for the ordering; it is the same information from the
    # only place available this early. The alternative -- hoisting the 200-line SELFTEST_FILES
    # literal to module scope -- moves a large diff for one line's benefit and would collide with
    # every other session editing that map.
    #
    # SCOPED TO THE DIRECTORIES A COPY CAN LAND IN, not a recursive walk: the copy is written beside
    # its source, so the reachable set is exactly the directories holding registered selftest files.
    # A `**` glob from the repo root would stat through data/ -- 206 GB -- on every commit.
    #
    # NO COUNTER: scripts/test_hookstaged_sweep.py lifts these lines verbatim from `_sweep_dirs = `
    # onward and exec's them, so any name bound ABOVE that line is a NameError in the test. Every
    # name this block uses is bound inside it, and each removal already prints its own line.
    #
    # LIVE COPIES ARE NOT STALE. The scope above holds the directory of every registered selftest
    # file, which includes scripts/hooks/ -- so this sweep can reach the copy an OUTER run is at
    # that moment executing as its own __file__. It did: 2026-09-09, a merge staging this file had
    # its .hookstaged_pre-commit unlinked by a nested run's sweep, and the outer selftest died
    # reading its own source after every world had passed. The parent exports the paths it owns in
    # AUPAI_HOOK_LIVE_COPIES and nested runs inherit it, so "in use" is read from the process that
    # created the file rather than guessed from an mtime.
    _sweep_dirs = {os.path.dirname(os.path.join(repo_root(), f)) for f in _registered_selftest_paths()}
    _sweep_dirs.add(repo_root())
    _live = {p for p in os.environ.get("AUPAI_HOOK_LIVE_COPIES", "").split(os.pathsep) if p}
    for _dir in _sweep_dirs:
        for _stale in glob.glob(os.path.join(_dir, ".hookstaged_*")):
            if os.path.abspath(_stale) in _live:
                continue
            try:
                os.unlink(_stale)
                print(f"hook: removed stale {os.path.relpath(_stale, repo_root())} (a killed hook "
                      f"run left it; it would refuse the next commit as an unregistered selftest "
                      f"file)", file=sys.stderr)
            except OSError:
                pass

    # A commit in the INTEGRATION tree, on main, from a session that is not the
    # controller. Three sessions did this tonight (e1 x5, tilerl staged, one merge
    # left unfinished), and the worktree rule was prose until something refused it.
    # Identity is the tree, not the session: a linked worktree's toplevel differs
    # from the common dir's parent, and no session id exists in the environment.
    # AUPAI_CONTROLLER=1 marks the controller's shell; a merge commit is exempt
    # because integrating branches into main is exactly the controller's job.
    t0 = time.time()
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip()
    common = subprocess.run(["git", "rev-parse", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
    if top and common:
        # realpath, not abspath: a symlinked path (/tmp -> /private/tmp on macOS)
        # makes the two sides differ as strings while naming one directory, and the
        # check then silently never fires -- which is how it first tested green.
        common_abs = os.path.realpath(common)
        # See _merging: MERGE_HEAD alone is False during a CLEAN merge, because git
        # calls this file as pre-merge-commit before writing it.
        merging = _merging(common_abs)
        # THE TREE, NOT THE BRANCH (tilerl's flip, 2026-09-05). This used to be
        # `main_tree and branch == "main"`, where branch came from `rev-parse
        # --abbrev-ref HEAD`. Detached, that returns the literal "HEAD", so the moment
        # the integration tree was detached the guard went INERT -- for everyone, not
        # just the controller. Detaching is what makes the tree unwritable-by-accident,
        # and it was also what turned off the check enforcing it. A commit here is wrong
        # whatever HEAD points at.
        #
        # de's predicate rather than a second spelling of the idea (de-51): main worktree
        # AND has linked worktrees, both read from git, no path and no branch. The path
        # form was one laptop's layout -- wrong on the pod, wrong in CI.
        #
        # NO CONTROLLER EXEMPTION. `AUPAI_CONTROLLER=1 git commit` in the integration
        # tree ends with the flip (4c's ruling): the controller commits from its own
        # worktree through merge_main like everyone else.
        #
        # AN UNIMPORTABLE PREDICATE IS LOUD, NOT SILENT. Failing open here would disarm
        # the guard at exactly the moment it is needed -- the tree is detached, so the
        # old branch test is gone too, and a stray commit in the integration tree would
        # be accepted with no refusal at all. The predicate's OWN fail-open (no git, git
        # erroring -> False) is a different thing and stays: that is a tree which cannot
        # be the integration tree. This is the module being absent, which is a defect.
        try:
            sys.path.insert(0, os.path.join(repo_root() or ".", "scripts"))
            from integration_tree import is_integration_tree
            _is_integ = is_integration_tree(top)
        except Exception as _e:  # noqa: BLE001
            print(f"hook: NOTE -- scripts/integration_tree.py did not import "
                  f"({type(_e).__name__}); the integration-tree guard did NOT run",
                  file=sys.stderr)
            _is_integ = False
        if _is_integ and not merging:
            print(
                "REFUSING: this is the integration tree. Commit in your own "
                "worktree and merge:\n"
                "  git -C <your worktree> commit <paths>\n"
                f"  {top}/scripts/merge_main.sh <your branch>\n"
                "A file left dirty here blocks every other session's move of it and gets "
                "swept into their commits. There is no controller exemption: the "
                "controller commits from its own worktree too.",
                file=sys.stderr,
            )
            sys.exit(1)
        _refuse_copied_worktree(top)
        _refuse_committing_on_main(merging)
    print(f"hook: tree check {time.time() - t0:.2f}s", file=sys.stderr)

    # Behind main. A conclusion drawn from a check has two inputs -- the check's code
    # and the tree it ran on -- and we have only ever reported the first. On
    # 2026-09-01 no_foreground_pod_training was fixed four times; 3b hit the version
    # before the first fix, and two sessions each saw the other's item red in their
    # own tree while both were done. "This check has a bug" and "this check has a bug
    # in my tree" are different sentences, and nothing in the output told them apart.
    #
    # Refuse, never merge. An automatic merge can conflict, and a hook that drops your
    # tree into a conflict you did not ask for is worse than one that stops you; an
    # automatic rebase would rewrite history other sessions have already merged
    # (AGENTS.md). Refusal is the only shape that holds: every rule today that
    # depended on remembering broke, and every rule that refused at the point of use
    # held (fb ruling, user order, 2026-09-01).
    t0 = time.time()
    behind = _behind_main()
    # --git-path, not --git-common-dir: in a linked worktree the common dir is the
    # SHARED .git, where MERGE_HEAD never appears -- a worktree's lives in
    # .git/worktrees/<name>/. So the merging exemption was always false here, and this
    # gate refused the merge commit that resolves being behind, which is the one commit
    # it must never block (de, 2026-09-01).
    #
    # The tree check twenty lines above reads MERGE_HEAD the old way and is CORRECT
    # there, which an earlier version of this comment got wrong: its read only runs
    # under `if main_tree`, and in the integration tree the common dir IS .git, so
    # MERGE_HEAD is exactly where it looks. The bug was never the expression -- it was
    # the expression in a context nobody had evaluated it in (e1 caught the
    # overcorrection).
    #
    # --git-path fixed the WHERE and left the WHEN: on a clean merge git calls
    # pre-merge-commit before MERGE_HEAD exists anywhere, so this refused
    # `git merge --no-edit main` -- the command this very message prints. Measured
    # 2026-09-02 in a diverged worktree; the conflict path it was tested on has
    # MERGE_HEAD on disk and passed. Now shares _merging with the tree check (e1-12).
    merging = _merging()
    # AN APPEND-ONLY LEDGER COMMIT CANNOT WRITE ON TOP OF CODE, so behind-main has nothing to
    # say about it (de, on 6e's C5 ruling 2026-09-04). The refusal's own reason is "this commit
    # writes on top of code main has already moved past, and any check you ran said nothing
    # about which version it tested" -- a commit whose every staged path merges by union adds
    # rows to a ledger, runs no check, and is resolved by git without reference to what main
    # did. Refusing it costs the row.
    #
    # And the cost was measured, twice in one hour: `harness friction add --commit` appends the
    # row and then the hook refuses the commit, leaving the ledger dirty, which is precisely
    # what --commit exists to prevent -- b0's friction row needed AUPAI_BEHIND_MAIN_OK=1 to
    # land. The second time, the tree went one commit behind BETWEEN a clean `git merge main`
    # and the commit two seconds later, so "merge first" is not a fix available to the writer:
    # main moves faster than a commit takes on a repo with six sessions. A friction row is the
    # one write that must never be refused, because it is how the refusals get fixed.
    #
    # NARROW: every staged path must be union-merged. One code path alongside a ledger and the
    # refusal stands -- the exemption is about what the commit CAN break, not about intent, so
    # it cannot be widened by adding a ledger row to a code commit.
    _staged_all = staged("ACDMR")
    _ledger_only = bool(_staged_all) and set(_staged_all) <= _union_merged(_staged_all)
    # THE OVERLAP, NOT THE COUNT (tilerl-31). See _main_touched_staged: the refusal's reason
    # is about files, so the condition is which of them main has moved. `behind` stays in the
    # message because it is what the reader sees in `git status`, and it still gates the
    # cheap early-out -- an up-to-date tree needs no diff at all.
    _clash = _main_touched_staged(_staged_all) if behind and not _ledger_only and not merging else []
    if _clash and os.environ.get("AUPAI_BEHIND_MAIN_OK") != "1":
        print(
            f"REFUSING: main has changed {len(_clash)} file(s) this commit stages, and this "
            f"tree is {behind} commit(s) behind it: {', '.join(_clash[:4])}\n"
            f"Merge first:\n"
            f"  git merge --no-edit main\n"
            f"Committing here writes on top of code main has already moved past, and "
            f"any check you ran said nothing about which version it tested.\n"
            f"Being behind main is NOT itself a refusal: main moving on files you do not "
            f"stage costs you nothing and this commit would be allowed.\n"
            f"A commit staging ONLY files git can merge WITHOUT a person -- merge=union or a "
            f"named driver, per .gitattributes -- is exempt and needs no flag.\n"
            f"Deliberate exception (reproducing something that only fails on the older "
            f"code): AUPAI_BEHIND_MAIN_OK=1 git commit ... -- the cost is that this "
            f"commit and every check behind it describe a tree nobody else has.",
            file=sys.stderr,
        )
        sys.exit(1)
    # THE OVERRIDE RECORDS ITSELF HERE AND IS WRITTEN BY THE GATE. Measured 2026-09-05: 0 of 62
    # friction rows named AUPAI_BEHIND_MAIN_OK or AUPAI_CONTROLLER, and not because overrides are
    # rare -- one session used the flag four times in two hours. Nobody logs one, so a metric
    # counting them measures the logging habit and reads 0 as "no overrides happened", the
    # absent-vs-empty error this repo keeps paying for.
    #
    # IT DOES NOT MOVE WHOLESALE TO THE GATE. The gate runs later and sees only a merge commit --
    # it cannot tell whether any commit on the branch used the flag. The hook is the one party
    # that KNOWS. So the EVENT is captured here and the ROW is written there.
    #
    # UNDER THE GIT DIR, NOT THE WORKING TREE. The previous version called `harness friction add`
    # from inside a commit, which appended to a ledger while the index was git's -- the row landed
    # dirty and refused the next merge (commit -> refused -> commit again, de 2026-09-05). A file
    # under $(git rev-parse --git-dir) does not appear in `git status --porcelain` (measured), and
    # each worktree has its own git dir, so two sessions' pending rows cannot collide.
    #
    # APPEND-ONLY, drained and truncated by merge_main after its CAS: a gate killed between
    # reading and truncating leaves the rows for the next run rather than losing them.
    if _clash:
        try:
            _gd = subprocess.run(["git", "rev-parse", "--git-dir"], capture_output=True,
                                 text=True, timeout=10).stdout.strip()
            if _gd:
                _files = ', '.join(_clash[:3])
                with open(os.path.join(_gd, "aupai_pending_friction"), "a",
                          encoding="utf-8") as _fh:
                    _fh.write(f"AUPAI_BEHIND_MAIN_OK=1 used to commit {behind} behind main "
                              f"({_files})\n")
        except Exception as _e:  # noqa: BLE001 - a ledger write must never block a commit
            print(f"hook: NOTE -- could not record the override ({type(_e).__name__}); the "
                  f"override stands, the count will be short by one", file=sys.stderr)
    print(f"hook: behind-main {time.time() - t0:.2f}s ({behind} behind)", file=sys.stderr)

    # Shared-files rule (T0, 2026-09-04): a staged edit to a listed shared file needs a live
    # claim -- the announce is now a file (runs/claims/files/<path>.json), not a conversation.
    # Three recorded incidents are the justification: a push rolled back 3b's build_corpus
    # feature (2026-08-30), a `git checkout` erased another session's uncommitted device gate
    # (2026-08-31), `git add -A` swept five sessions' work into one commit (d535674).
    t0 = time.time()
    # A MERGE COMMIT IS EXEMPT: the claim lives in the branch tree where the shared-file
    # edit was committed, so main's hook could never see it. The branch commit already
    # enforced the claim; the merge is integration, and merge_main.sh releases the claim
    # (owner ones) afterwards.
    _shared = ("train.py", "sft.py", "sft_math.py", "AGENTS.md")
    _unclaimed = [p for p in _staged_all if p in _shared] if not merging else []
    if _unclaimed:
        _claims_dir = os.path.join(top, "runs", "claims", "files")
        _missing = []
        for p in _unclaimed:
            _cp = os.path.join(_claims_dir, p.replace("/", "__") + ".json")
            _live = False
            if os.path.exists(_cp):
                try:
                    _rec = json.load(open(_cp, encoding="utf-8"))
                    _live = (time.time() - _rec.get("time", 0)) <= 6 * 3600
                except (OSError, ValueError):
                    _live = False
            if not _live:
                _missing.append(p)
        if _missing and os.environ.get("AUPAI_SHARED_FILE_OK") != "1":
            print(
                "REFUSING: editing a listed shared file without a live claim (Shared-files "
                "rule). The announce is now a file, not a message:\n"
                "  python scripts/harness.py claim-file acquire --path <file>\n"
                f"unclaimed: {', '.join(_missing)}\n"
                "A claim is released on merge (scripts/merge_main.sh).",
                file=sys.stderr,
            )
            sys.exit(1)
    print(f"hook: shared-file claim {time.time() - t0:.2f}s", file=sys.stderr)

    t0 = time.time()
    fail = False
    for f in staged("AM"):
        if os.path.isfile(f):
            sz = os.path.getsize(f)
            if sz > MAX:
                print(
                    f"REFUSING: {f} is {sz} bytes (>5MB) -- "
                    f"large files are gitignored, not committed", file=sys.stderr,
                )
                fail = True
    for f in staged("A"):
        if f.startswith("data/") and not any(fnmatch.fnmatch(f, p) for p in ALLOWED):
            print(
                f"REFUSING: {f} is a new data/ path not in the allow-list -- "
                f"add to scripts/hooks/pre-commit ALLOWED or use --no-verify "
                f"with justification", file=sys.stderr,
            )
            fail = True
    if fail:
        sys.exit(1)
    print(f"hook: blob+allowlist {time.time() - t0:.2f}s", file=sys.stderr)

    # CREDENTIAL SHAPES IN STAGED CONTENT. 2026-09-05: data/probes/api_cloze.jsonl carried a live
    # third-party Postgres credential into 32b4ed22 in a public repo, GitHub push protection caught
    # it at the LAST gate, and main froze under the merge lock while 12 commits were rewritten. The
    # detection is the same either way; the difference is that here the remedy is deleting a line.
    #
    # BEFORE THE SLOW GATES on purpose -- ruff, selftests and harness check cost ~45 s below, and a
    # commit that is going to be refused for a secret should be refused in 0.2 s. Reads the INDEX,
    # not the working tree: the staged bytes are what becomes the commit.
    t0 = time.time()
    _cred_mod = os.path.join(repo_root() or ".", "scripts", "credential_scan.py")
    _in_head = subprocess.run(["git", "-C", repo_root() or ".", "cat-file", "-e",
                               "HEAD:scripts/credential_scan.py"],
                              capture_output=True).returncode == 0
    if not os.path.exists(_cred_mod) and not _in_head:
        # A TREE THAT NEVER HAD THE GATE, not a tree where it was removed. The hook's own selftest
        # builds ten partial repos holding a handful of files and no scripts/ at all, and a
        # blanket refusal turned every one of them red -- world 8 reported "refused but not by the
        # mapped test", naming this scanner. The distinction is HEAD: absent from the working tree
        # AND from HEAD means the file was never here, which is a fixture; present in HEAD and
        # missing from the tree means someone removed it, which is the bypass and still refuses
        # below. Announced rather than silent -- an unrun gate that prints nothing is the state
        # this whole commit is about.
        print("hook: credential scan SKIPPED (scripts/credential_scan.py is not in this tree or "
              "its HEAD -- a partial world, not the repo)", file=sys.stderr)
    else:
        try:
            sys.path.insert(0, os.path.join(repo_root(), "scripts"))
            import credential_scan

            _cred = credential_scan.scan_staged(repo_root())
        except Exception as e:
            # A SCANNER THAT DID NOT RUN IS NOT A CLEAN RESULT (e1-16's shape, where an unrunnable
            # ruff read as green). Refuse and say why, rather than passing silently.
            print(f"REFUSING: the credential scan could not run ({type(e).__name__}: {e}). A gate "
                  f"that did not execute is not a pass -- fix scripts/credential_scan.py, or "
                  f"--no-verify only after reading the staged diff yourself.", file=sys.stderr)
            sys.exit(1)
        if _cred:
            credential_scan.report(_cred)
            sys.exit(1)
        print(f"hook: credential scan {time.time() - t0:.2f}s", file=sys.stderr)

    # A staged runs/*.jsonl must not lose a record. de-33.
    #
    # a59ac1f staged a runs/experiments.jsonl one line shorter than its parent and dropped b0's
    # ab_zeroinit AMENDMENT row. All five hook lines were green; b0 found it by eye, reading
    # "1 -" in the diffstat. These files merge by union, so a row that leaves is not a conflict
    # anyone resolves -- it is a record that stops existing.
    #
    # The predicate lives in scripts/ledger_audit.py (b0) over de's subsume/key_present, and is
    # PER LEDGER because the write tools differ: exp.py appends, harness.py:5805 rewrites
    # tasks.jsonl whole, score_matrix.py:573 replaces a row by design. Subsumption everywhere
    # would refuse 30 of tasks.jsonl's last 161 commits -- all of them a plain
    # `harness task done`. That is why this calls regressions() instead of comparing lines.
    #
    # WHY THE ESCAPE IS AN ENV VAR AND NOT A COMMIT-MESSAGE MARKER: git does not pass the
    # message to pre-commit, and .git/COMMIT_EDITMSG at this point still holds the PREVIOUS
    # commit's message. Measured four ways in a real repo (de, 2026-09-03): the first commit
    # sees no file at all, and a plain commit right after a marked one reads the marker it did
    # not write. An exception keyed on that would exempt commits nobody declared and refuse the
    # ones that were. AUPAI_LEDGER_REWRITE names the intent of THIS invocation, and unlike
    # --no-verify it does not also skip blob size, ruff, the selftests and harness check.
    t0 = time.time()
    _ledger_note = ""
    try:
        sys.path.insert(0, os.path.join(repo_root(), "scripts"))
        import ledger_audit as _la

        _why = os.environ.get("AUPAI_LEDGER_REWRITE", "").strip()
        _hits = []
        _dups = []
        # ON A MERGE, THE OTHER PARENT IS ALSO A BASELINE. The comparison below is
        # HEAD-vs-index, i.e. OURS against the result, and it cannot see a row that only
        # THEIRS had -- exactly the shape 6e reported (e1's params_leg amendment). MERGE_HEAD
        # is on disk for the whole of a conflicted merge and for `git commit` finishing any
        # merge, so a merge commit gets both baselines and an ordinary commit gets one.
        _merge_head = subprocess.run(["git", "rev-parse", "-q", "--verify", "MERGE_HEAD"],
                                     capture_output=True, text=True).stdout.strip()
        # AND THE FILE LIST CANNOT COME FROM `staged("M")` ON A MERGE. MEASURED 2026-09-03:
        # a merge resolved by taking OURS whole leaves the ledger byte-identical to HEAD, so
        # `git diff --cached` reports NOTHING staged -- the worst case is invisible to the
        # step that exists to catch it, because the only evidence is in the other parent.
        # On a merge, examine every ledger either parent touched.
        _staged_ledgers = [f for f in staged("M") if f in _la.PREDICATE]
        if _merge_head:
            _other_touched = subprocess.run(
                ["git", "diff", "--name-only", f"{_merge_head}...HEAD", "--"],
                capture_output=True, text=True)
            _both = subprocess.run(
                ["git", "diff", "--name-only", _merge_head, "--"],
                capture_output=True, text=True)
            for _f in set(_other_touched.stdout.split()) | set(_both.stdout.split()):
                if _f in _la.PREDICATE and _f not in _staged_ledgers:
                    _staged_ledgers.append(_f)
        for f in _staged_ledgers:
            head = subprocess.run(["git", "show", f"HEAD:{f}"], capture_output=True, text=True)
            index = subprocess.run(["git", "show", f":{f}"], capture_output=True, text=True)
            if head.returncode or index.returncode:
                continue
            bad = _la.regressions(f, head.stdout, index.stdout)
            if _merge_head:
                other = subprocess.run(["git", "show", f"{_merge_head}:{f}"],
                                       capture_output=True, text=True)
                if not other.returncode:
                    # Same predicate, other baseline: one place to be wrong. A key missing
                    # from both comparisons is reported once -- dedup on the key, since the
                    # operator's fix is the same row either way.
                    seen = {b[0] for b in bad}
                    for b in _la.regressions(f, other.stdout, index.stdout):
                        if b[0] not in seen:
                            bad.append(b)
                            seen.add(b[0])
            if bad:
                _hits.append((f, bad))
            # A duplicate key, on the one ledger whose writer cannot produce one. Scoped by
            # DUP_IS_FAULT, not applied file-wide: exp.py APPENDS events under the start row's
            # key, so experiments/tasks/board/retro carry duplicates by design and a file-wide
            # rule would refuse 99 keys in tasks alone.
            _dups.extend((f, k) for k in _la.duplicates(f, index.stdout))
        if _hits:
            total = sum(len(b) for _, b in _hits)
            for f, bad in _hits:
                print(f"{'ALLOWING' if _why else 'REFUSING'}: {f} loses {len(bad)} record(s) "
                      f"-- these files merge by union, so a row that leaves is a record that "
                      f"stops existing (de-33: a59ac1f dropped b0's ab_zeroinit amendment "
                      f"under five green hook lines)", file=sys.stderr)
                for key, row in bad[:4]:
                    print(f"    - {key}", file=sys.stderr)
                if len(bad) > 4:
                    print(f"    ... and {len(bad) - 4} more", file=sys.stderr)
            if _why:
                # Hand the finding to commit-msg, which is the only hook that sees THIS
                # commit's message. The env var is a pass; the marker file is what forces the
                # reason into history, where a reader six weeks out can find it.
                _mark = subprocess.run(
                    ["git", "rev-parse", "--git-path", "AUPAI_LEDGER_REGRESSED"],
                    capture_output=True, text=True).stdout.strip()
                if _mark:
                    try:
                        with open(_mark, "w", encoding="utf-8") as fh:
                            fh.write("\n".join(f"{f} {key}" for f, bad in _hits for key, _ in bad))
                    except OSError:
                        pass
                print(f"AUPAI_LEDGER_REWRITE={_why!r} -- allowed here; commit-msg will require "
                      f"`ledger-rewrite: <why>` in the message. The env var is not recoverable "
                      f"from history, so the message is the only place the reason survives.",
                      file=sys.stderr)
                _ledger_note = f", {total} loss(es) ALLOWED by AUPAI_LEDGER_REWRITE"
            else:
                print("If the loss is intentional -- reconciling duplicate rows from a pod "
                      "sync is the real case -- re-run with "
                      "AUPAI_LEDGER_REWRITE='<why>' and say the same thing in the commit "
                      "message. Do NOT use --no-verify: it also skips blob size, ruff, the "
                      "selftests and harness check.", file=sys.stderr)
                sys.exit(1)
        if _dups:
            # Judge the DELTA, not the presence. score_matrix.jsonl carried 22 duplicates until
            # 44's fold landed, and "any duplicate refuses" would have refused the folding commit
            # itself along with every other commit touching the file. Refuse only a key that HEAD
            # did not already have duplicated; a commit that leaves or reduces them says so in
            # the count line and passes.
            _added = []
            for f in {f for f, _ in _dups}:
                head = subprocess.run(["git", "show", f"HEAD:{f}"], capture_output=True, text=True)
                was = set(_la.duplicates(f, head.stdout)) if not head.returncode else set()
                _added += [(f, k) for g, k in _dups if g == f and k not in was]
            if _added:
                for f, k in _added[:6]:
                    print(f"REFUSING: {f} has more than one row under {k}, which HEAD did not. "
                          f"Its writer replaces the same key by design "
                          f"(eval/score_matrix.py:573), so a second row is not something it "
                          f"can produce -- it arrives through a cross-branch union merge, "
                          f"where the .lock does not reach.", file=sys.stderr)
                if len(_added) > 6:
                    print(f"    ... and {len(_added) - 6} more", file=sys.stderr)
                print("Fold the duplicate rows and commit the folded file, or if the "
                      "duplication is real, re-run with AUPAI_LEDGER_REWRITE='<why>'.",
                      file=sys.stderr)
                if not _why:
                    sys.exit(1)
            else:
                _ledger_note += (f", {len(_dups)} pre-existing duplicate key(s) "
                                 f"(none added)")
    except ImportError as _ie:
        # NAME THE MODULE THAT FAILED. "ledger_audit absent" was misleading twice over: the
        # module can be present and its own import of test_ledger_predicates the thing that
        # failed, which is what happened in this file's world 7 while I was writing it -- the
        # step silently did nothing and I read it as the hook failing to catch the defect.
        # A SKIP that misattributes its cause costs more than a SKIP that says nothing.
        _ledger_note = f", ledger audit SKIPPED: {_ie.__class__.__name__}: {_ie}"
    print(f"hook: ledger-append-only {time.time() - t0:.2f}s "
          f"({len(_staged_ledgers) if '_staged_ledgers' in dir() else 0} staged"
          f"{_ledger_note})", file=sys.stderr)

    # Ruff E9/F on staged .py files -- the same gate CI runs, caught at commit time.
    t0 = time.time()
    py_files = [f for f in staged("AM") if f.endswith(".py")]
    if py_files:
        try:
            r = subprocess.run(
                ["ruff", "check", "--select", "E9,F", *py_files],
                capture_output=True, text=True,
            )
            if r.returncode != 0:
                print(f"REFUSING: ruff E9/F failed:\n{r.stdout}", file=sys.stderr)
                sys.exit(1)
        except FileNotFoundError:
            pass  # ruff not installed; CI catches it
    print(f"hook: ruff {time.time() - t0:.2f}s", file=sys.stderr)

    # A staged file that carries its own --selftest must pass it. Today a readout
    # commit landed with its selftest RED: the assertion pinned the old wording of a
    # refusal message and the message had been reworded in the same commit. Nothing
    # ran it, so the hook printed five green lines over a broken guard -- the hook
    # checked what it happened to check, not what the commit changed (b0, 2026-09-01).
