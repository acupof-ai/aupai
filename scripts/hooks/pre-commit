    # from it is unguarded, one level down: a correct judgement applied at the wrong
    # granularity, silently not checking.
    NEEDS_DATA = {
        "datagen/prepare_sft.py": "imports loader off sys.path; ModuleNotFoundError outside its runner",
        "datagen/rescore_code.py": "sandbox_exec needs root (chroot + namespaces); pod only",
        # The sandbox itself. 17 known answers, every one of which needs root plus unshare,
