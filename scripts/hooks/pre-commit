#!/usr/bin/env python3
"""Pre-commit hook: refuse oversized blobs and unlisted data/ paths; keep pod
manifest fresh from the index.

Install: python scripts/harness.py install-hooks
Bypass: git commit --no-verify (use only for a legitimate new data file,
and say why in the commit message).

The 5MB limit is the same as harness's no_oversized_blob check -- this hook
is the first line (commit time), CI is the second. The data/ allow-list is
the set of paths that may be committed; anything else under data/ is refused
because large data belongs in .gitignore, not history (d535674 swept 234MB
under data/_corpus_unsanitized/ into one commit).

The manifest regeneration writes data/pod_head_manifest.txt from the INDEX
(staged blobs, git show :path), not HEAD or the working tree, so the committed
manifest matches HEAD after the commit lands. This eliminates the "manifest
stale" CI red that required a separate "regenerate pod manifest" commit.
"""
import fnmatch
import os
import shutil
import subprocess
import sys
import tempfile

MAX = 5 * 1024 * 1024

ALLOWED = [
    "data/mix_*.json",
    "data/token_cache_pools.json",
    "data/eval/*",
    "data/synthetic/*",
    "data/corpus/sample/*",
    "data/corpus/.counts.json",
    "data/PROVENANCE.md",
    "data/MANIFEST.tsv",
    "data/pod_head_manifest.txt",
    "data/env_fp_baseline.json",
    "data/raw/*_manifest.txt",
    "data/sft/*.py",
    "data/t2s_table.json",
    "data/REBUILD_PLAN_*.md",
    "data/rl/*",
    "data/sft_contamination_baseline.json",
]


def repo_root():
    return subprocess.run(["git", "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True).stdout.strip()


def _behind_main():
    """How many commits main has that this tree does not. 0 on main itself, and 0
    when the count cannot be taken -- a tree with no main (a fresh temp repo, a
    clone of one branch) must not be refused for a question that has no answer."""
    r = subprocess.run(["git", "rev-list", "--count", "HEAD..main"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return 0
    try:
        return int(r.stdout.strip())
    except ValueError:
        return 0


def _merging(common_abs=None):
    """Is this invocation part of a merge? Three signals, because each is absent in
    some real case and MERGE_HEAD alone was wrong in BOTH gates below.

    git runs this one file under two names. `git commit` (finishing a CONFLICTED
    merge) sees MERGE_HEAD already on disk. `git merge` does not call pre-commit at
    all -- it calls pre-merge-commit, symlinked here by cmd_install_hooks -- and on a
    CLEAN merge it calls it BEFORE MERGE_HEAD is written. So a clean merge looks like
    no merge, and both exemptions below silently failed on it:

      integration tree   `git merge --no-edit e1` on main was refused and left a
                         half-finished merge in the shared tree (2026-09-02)
      behind main        `git merge --no-edit main` in a diverged worktree was
                         refused -- the exact command its own message tells you to
                         run (measured 2026-09-02, a true merge, not a fast-forward)

    Both were tested by resolving a CONFLICT, where MERGE_HEAD does exist, so both
    read green. A fast-forward runs no hook at all, which is why the everyday case
    hid it too.

    --git-path resolves MERGE_HEAD per worktree (.git/worktrees/<name>/), which the
    common dir does not; pass common_abs to also accept the integration tree's own
    .git, where the tree check knows the common dir IS .git.
    """
    if common_abs and os.path.exists(os.path.join(common_abs, "MERGE_HEAD")):
        return True
    p = subprocess.run(["git", "rev-parse", "--git-path", "MERGE_HEAD"],
                       capture_output=True, text=True).stdout.strip()
    if p and os.path.exists(p):
        return True
    return (os.path.basename(sys.argv[0]) == "pre-merge-commit"
            or os.environ.get("GIT_REFLOG_ACTION", "").startswith("merge"))


def staged(diff_filter):
    r = subprocess.run(
        ["git", "diff", "--cached", "--name-only", f"--diff-filter={diff_filter}"],
        capture_output=True, text=True,
    )
    return [f for f in r.stdout.splitlines() if f.strip()]


def main():
    # Stage timings in the output: a hook people wait minutes for is a hook they
    # bypass (4a7dd56 --no-verify precedent, 2026-08-31).
    import time

    t_start = time.time()

    # A commit in the INTEGRATION tree, on main, from a session that is not the
    # controller. Three sessions did this tonight (e1 x5, tilerl staged, one merge
    # left unfinished), and the worktree rule was prose until something refused it.
    # Identity is the tree, not the session: a linked worktree's toplevel differs
    # from the common dir's parent, and no session id exists in the environment.
    # AUPAI_CONTROLLER=1 marks the controller's shell; a merge commit is exempt
    # because integrating branches into main is exactly the controller's job.
    t0 = time.time()
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip()
    common = subprocess.run(["git", "rev-parse", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
    if top and common:
        # realpath, not abspath: a symlinked path (/tmp -> /private/tmp on macOS)
        # makes the two sides differ as strings while naming one directory, and the
        # check then silently never fires -- which is how it first tested green.
        common_abs = os.path.realpath(common)
        # THE integration tree, not any repo that happens to be on main: the rule is
        # about the one shared checkout other sessions merge into. Without this every
        # temp repo in the selftest counts as an integration tree, and the tests that
        # commit to main there start refusing (four of them did).
        integration = os.environ.get("AUPAI_INTEGRATION_TREE") or "/Users/bytedance/code/aupai"
        main_tree = (os.path.dirname(common_abs) == os.path.realpath(top)
                     and os.path.realpath(top) == os.path.realpath(integration))
        branch = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                                capture_output=True, text=True).stdout.strip()
        # See _merging: MERGE_HEAD alone is False during a CLEAN merge, because git
        # calls this file as pre-merge-commit before writing it.
        merging = _merging(common_abs)
        if main_tree and branch == "main" and not merging and os.environ.get("AUPAI_CONTROLLER") != "1":
            print(
                "REFUSING: this is the integration tree on main. Commit in your own "
                "worktree and merge:\n"
                "  git -C <your worktree> commit <paths>\n"
                f"  git -C {top} merge --no-edit <your branch>\n"
                "A file left dirty here blocks every other session's move of it and gets "
                "swept into their commits. Controller: AUPAI_CONTROLLER=1 git commit ...",
                file=sys.stderr,
            )
            sys.exit(1)
    print(f"hook: tree check {time.time() - t0:.2f}s", file=sys.stderr)

    # Behind main. A conclusion drawn from a check has two inputs -- the check's code
    # and the tree it ran on -- and we have only ever reported the first. On
    # 2026-09-01 no_foreground_pod_training was fixed four times; 3b hit the version
    # before the first fix, and two sessions each saw the other's item red in their
    # own tree while both were done. "This check has a bug" and "this check has a bug
    # in my tree" are different sentences, and nothing in the output told them apart.
    #
    # Refuse, never merge. An automatic merge can conflict, and a hook that drops your
    # tree into a conflict you did not ask for is worse than one that stops you; an
    # automatic rebase would rewrite history other sessions have already merged
    # (AGENTS.md). Refusal is the only shape that holds: every rule today that
    # depended on remembering broke, and every rule that refused at the point of use
    # held (fb ruling, user order, 2026-09-01).
    t0 = time.time()
    behind = _behind_main()
    # --git-path, not --git-common-dir: in a linked worktree the common dir is the
    # SHARED .git, where MERGE_HEAD never appears -- a worktree's lives in
    # .git/worktrees/<name>/. So the merging exemption was always false here, and this
    # gate refused the merge commit that resolves being behind, which is the one commit
    # it must never block (de, 2026-09-01).
    #
    # The tree check twenty lines above reads MERGE_HEAD the old way and is CORRECT
    # there, which an earlier version of this comment got wrong: its read only runs
    # under `if main_tree`, and in the integration tree the common dir IS .git, so
    # MERGE_HEAD is exactly where it looks. The bug was never the expression -- it was
    # the expression in a context nobody had evaluated it in (e1 caught the
    # overcorrection).
    #
    # --git-path fixed the WHERE and left the WHEN: on a clean merge git calls
    # pre-merge-commit before MERGE_HEAD exists anywhere, so this refused
    # `git merge --no-edit main` -- the command this very message prints. Measured
    # 2026-09-02 in a diverged worktree; the conflict path it was tested on has
    # MERGE_HEAD on disk and passed. Now shares _merging with the tree check (e1-12).
    merging = _merging()
    if behind and not merging and os.environ.get("AUPAI_BEHIND_MAIN_OK") != "1":
        print(
            f"REFUSING: this tree is {behind} commit(s) behind main. Merge first:\n"
            f"  git merge --no-edit main\n"
            f"Committing here writes on top of code main has already moved past, and "
            f"any check you ran said nothing about which version it tested.\n"
            f"Deliberate exception (reproducing something that only fails on the older "
            f"code): AUPAI_BEHIND_MAIN_OK=1 git commit ... -- the cost is that this "
            f"commit and every check behind it describe a tree nobody else has.",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"hook: behind-main {time.time() - t0:.2f}s ({behind} behind)", file=sys.stderr)

    t0 = time.time()
    fail = False
    for f in staged("AM"):
        if os.path.isfile(f):
            sz = os.path.getsize(f)
            if sz > MAX:
                print(
                    f"REFUSING: {f} is {sz} bytes (>5MB) -- "
                    f"large files are gitignored, not committed", file=sys.stderr,
                )
                fail = True
    for f in staged("A"):
        if f.startswith("data/") and not any(fnmatch.fnmatch(f, p) for p in ALLOWED):
            print(
                f"REFUSING: {f} is a new data/ path not in the allow-list -- "
                f"add to scripts/hooks/pre-commit ALLOWED or use --no-verify "
                f"with justification", file=sys.stderr,
            )
            fail = True
    if fail:
        sys.exit(1)
    print(f"hook: blob+allowlist {time.time() - t0:.2f}s", file=sys.stderr)

    # Ruff E9/F on staged .py files -- the same gate CI runs, caught at commit time.
    t0 = time.time()
    py_files = [f for f in staged("AM") if f.endswith(".py")]
    if py_files:
        try:
            r = subprocess.run(
                ["ruff", "check", "--select", "E9,F", *py_files],
                capture_output=True, text=True,
            )
            if r.returncode != 0:
                print(f"REFUSING: ruff E9/F failed:\n{r.stdout}", file=sys.stderr)
                sys.exit(1)
        except FileNotFoundError:
            pass  # ruff not installed; CI catches it
    print(f"hook: ruff {time.time() - t0:.2f}s", file=sys.stderr)

    # A staged file that carries its own --selftest must pass it. Today a readout
    # commit landed with its selftest RED: the assertion pinned the old wording of a
    # refusal message and the message had been reworded in the same commit. Nothing
    # ran it, so the hook printed five green lines over a broken guard -- the hook
    # checked what it happened to check, not what the commit changed (b0, 2026-09-01).
    # Run from the SELFTEST_FILES map rather than probing for the flag: a script that
    # exits 0 on an unknown argument would otherwise register as a pass.
    t0 = time.time()
    # Every file carrying its own --selftest, split by whether it can run at commit
    # time on a dev box. check_selftests_are_gated requires the union to be complete,
    # so a new selftest cannot be silently unguarded; NEEDS_DATA records WHY each one
    # is not run here, because "not in the map" and "cannot run here" are different
    # facts and only the second is acceptable.
    SELFTEST_FILES = {
        "eval/readout_30b.py", "eval/math_v2_like.py", "eval/score_matrix.py",
        "eval/score_math_formatfree.py", "eval/score_code_exec.py",
        "probes/chatml_in_corpus.py",
        "scripts/doc_numbers_check.py", "scripts/replay_cursor.py",
        "scripts/write_mix_500m.py",
        "scripts/restartability_audit.py", "scripts/shape_audit.py",
        "scripts/tokenizer_eval.py", "scripts/tokenizer_report.py",
        "scripts/launch_gate.py", "scripts/test_num_id_resolve.py",
        "scripts/launch_tests.py",
        "datagen/build_corpus.py", "datagen/clean_web.py", "datagen/distil_traces.py",
        "datagen/fetch_corpus.py", "datagen/score_web_27b.py",
        "probes/t65_gold_bpb.py", "probes/t66_gold_reachability.py",
        "probes/t67_self_repeat.py", "probes/t68_free_running.py",
        "probes/t69_copy_rate.py", "probes/t71_depth_lr_rule.py",
        "probes/t66_depth_shape.py", "scripts/stale_claims.py",
        "scripts/test_drop_zombies.py",
        "scripts/test_pod_sync_stamp.py",
        "scripts/test_shard_glob.py",
        "scripts/test_check_summary.py",
        "scripts/test_spawned_fast.py",
        "scripts/read_lr_probe.py",
        "scripts/read_resume_proof.py",
        # Nine files the gate could not see until its predicate widened from
        # '"--selftest" near add_argument' to '--selftest anywhere': these dispatch on
        # sys.argv instead of argparse. Five run clean at commit time and are gated
        # here; the other four are in NEEDS_DATA with their reason (de, 2026-09-01).
        "probes/t62_corpus_dup_rate.py", "probes/t63_cross_domain_dup.py",
        "probes/t64_val_head_overlap.py",
        "scripts/eval_artifacts.py", "scripts/pod_drift.py",
        "eval/compare_fewshot_arms.py", "scripts/audit_population_universals.py",
        # Three mathbank selftests the gate could not see at all: its population is an
        # os.listdir over eval/ scripts/ datagen/ probes/, so mathbank/ was outside what
        # it looked at, and "51 files, all gated" was true of that subset and silent
        # about these. Measured before adding: 0.08s / 0.07s / 0.14s, rc=0, no corpus or
        # checkpoint needed (de, 2026-09-02, de-12 step 1).
        "mathbank/arith_curriculum.py", "mathbank/dist_check.py",
        "mathbank/procedure_curriculum.py",
        # This file. Its selftest re-executes this script in a temp repo declared the
        # integration tree, so the guard is live rather than simulated (e1-12). No
        # recursion: the runner copies the staged blob to .hookstaged_pre-commit and
        # git never invokes that name, and the temp repo has no hooks installed.
        "scripts/hooks/pre-commit",
    }
    NEEDS_DATA = {
        "datagen/prepare_sft.py": "imports loader off sys.path; ModuleNotFoundError outside its runner",
        "datagen/rescore_code.py": "sandbox_exec needs root (chroot + namespaces); pod only",
        "eval/code_l0prime.py": "sandbox_exec needs root (chroot + namespaces); pod only",
        "probes/t65_near_dup_sweep.py": "imports build_corpus off sys.path; runner-only",
        "scripts/count_tokens.py": "reads corpus shards, which are gitignored",
        "eval/base_matrix.py": "asserts data/tokenizer.json, which is gitignored",
        "eval/lambada_zh.py": "asserts data/tokenizer.json, which is gitignored",
        "eval/domain_loss.py": "--selftest requires --ckpt, so it needs a checkpoint",
        # NOT "harness check is its selftest" -- that was false. `check` runs
        # run_checks(); `--selftest` is what verifies every check FAILs on its broken
        # world, and the two share no code path. The real reason is cost: measured
        # 68s wall on this machine, against ~9s for the whole rest of the hook, and
        # harness.py is touched by most commits that touch anything. A hook people
        # wait a minute for is a hook they --no-verify, which is the 4a7dd56
        # precedent this file already cites. It runs in CI, every push, where a
        # minute is free (de, 2026-09-01).
        "scripts/harness.py": "--selftest is 68s measured (rest of the hook is 9s); CI runs it every push",
    }
    # The STAGED blob, never the working tree. The gate's whole claim is "the version
    # being committed passes its own selftest", and running the working-tree copy tests
    # a version that may not be the one entering history. Constructed and confirmed:
    # stage a broken version, revert the working tree without staging, and the hook is
    # green while the broken version lands (Codex found it, de reproduced it,
    # 2026-09-01). The manifest half of this same hook already argues exactly this at
    # the `git show :scripts/pod_drift.py` below -- the rule was stated and then not
    # applied twelve lines above it.
    #
    # scripts/harness.py used to be exempt here, on the grounds that `harness check` is
    # its selftest. It is not: `check` runs run_checks(), while `--selftest` is what
    # verifies every check FAILs on its broken world. The core proof of the whole
    # harness has never run at commit time. It runs now, and it is slower than the rest
    # of this gate combined, which is the honest cost of actually checking.
    # The staged blob runs from a sibling path NEXT TO the real file. Two earlier
    # placements failed, and both for the same reason: a file's ROOT is
    # __file__-relative, so wherever the copy sits is what ROOT means to it.
    # repo_root()/.git raised NotADirectoryError in every linked worktree (.git is a
    # 60-byte file there) and blocked five sessions from committing; the
    # `git rev-parse --git-path hook-staged` tree that replaced it resolved, but every
    # path the file derived -- imports AND data -- then pointed into that empty tree.
    # PYTHONPATH can patch the imports; it cannot patch a data path, and
    # datagen/build_corpus.py resolves filters/pass1_garbage.py from ROOT and died on
    # FileNotFoundError. A red that says nothing about the commit is the same
    # false-alarm class as a green that says nothing: both make the gate unreadable.
    # Beside the real file, ROOT is the repo, and only the file under test differs.
    # try/finally, not a line after the loop: these copies now live in the WORKING TREE,
    # so a refusal that returns early would leave a .hookstaged_* file behind for the
    # next session to find dirty. The parallel tree could be left to rot; this cannot.
    staged_copies = []
    try:
        for f in sorted(SELFTEST_FILES & set(staged("AM"))):
            blob = subprocess.run(["git", "show", f":{f}"], capture_output=True)
            if blob.returncode != 0:
                print(f"REFUSING: cannot read staged {f}", file=sys.stderr)
                sys.exit(1)
            d, base = os.path.split(os.path.join(repo_root(), f))
            dst = os.path.join(d, f".hookstaged_{base}")
            staged_copies.append(dst)
            with open(dst, "wb") as fh:
                fh.write(blob.stdout)
            r = subprocess.run([sys.executable, dst, "--selftest"], capture_output=True,
                               text=True, cwd=repo_root(),
                               env={k: v for k, v in os.environ.items() if not k.startswith("GIT_")})
            if r.returncode != 0:
                tail = (r.stdout + r.stderr).strip().splitlines()[-6:]
                print(f"REFUSING: {f} --selftest failed (staged version):\n" + "\n".join(tail),
                      file=sys.stderr)
                sys.exit(1)
    finally:
        for p in staged_copies:
            if os.path.exists(p):
                os.unlink(p)
    print(f"hook: selftests {time.time() - t0:.2f}s", file=sys.stderr)

    # Harness check: the full invariant suite. ~5s locally; GPU/pod checks SKIP
    # on dev machines. CI is the second line; the commit is the first.
    t0 = time.time()
    repo = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    ).stdout.strip()
    if repo and os.path.isfile(os.path.join(repo, "scripts", "harness.py")):
        try:
            r = subprocess.run(
                [sys.executable, os.path.join(repo, "scripts", "harness.py"), "check"],
                capture_output=True, text=True, timeout=180,
            )
        except subprocess.TimeoutExpired:
            print("REFUSING: harness check did not finish in 180s -- rerun it by hand; "
                  "a hook that hangs is a hook people bypass", file=sys.stderr)
            sys.exit(1)
        if r.returncode != 0:
            # stdout AND stderr, and the FAIL lines pulled out. Printing stdout alone
            # produced "REFUSING: harness check failed:" with an empty reason when the
            # run crashed or a check raised, because those write to stderr (fb,
            # 2026-08-31). A refusal that does not say what failed cannot be acted on.
            failed = [ln for ln in r.stdout.splitlines() if "[FAIL]" in ln]
            print("REFUSING: harness check failed", file=sys.stderr)
            for ln in failed:
                print(f"  {ln.strip()}", file=sys.stderr)
            if not failed:
                print("  (no [FAIL] line -- the check run itself failed)", file=sys.stderr)
                print(f"  exit {r.returncode}", file=sys.stderr)
                tail = (r.stderr or r.stdout or "").strip().splitlines()[-15:]
                for ln in tail:
                    print(f"  {ln}", file=sys.stderr)
            # A ledger another session is mid-write reads as malformed for a moment.
            # Say so rather than leaving the reader to guess at a transient.
            print("  if this passes when rerun by hand, a concurrent write raced a "
                  "ledger read -- report it, do not --no-verify", file=sys.stderr)
            sys.exit(1)
        # TIMEOUT lines print on a PASSING run too. A check that hit its deadline did
        # not run, and the hook is where anyone would notice: while a timeout reported
        # SKIP, the hook printed nothing and `check` exited 0, so a check that timed out
        # on every run was a permanent silent pass (44, D5). The commit still proceeds --
        # one slow run is not a defect -- but the reader is told which check went unrun.
        for ln in r.stdout.splitlines():
            if "[TIME]" in ln:
                print(f"  TIMED OUT (did not run): {ln.strip()}", file=sys.stderr)
    print(f"hook: harness check {time.time() - t0:.2f}s", file=sys.stderr)

    # Regenerate pod manifest from staged content so it matches HEAD after commit.
    # Run the STAGED pod_drift.py (git show :path), never the working-tree copy:
    # a hook that executes uncommitted code is the fingerprint rule turned against us
    # (2026-08-31: an uncommitted 3-column format wrote a manifest the pod's parser
    # could not read, 147 false "missing", held a launch).
    # The staged copy is written inside the repo so its ROOT (__file__-relative) resolves.
    t0 = time.time()
    repo = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True
    ).stdout.strip()
    if repo:
        staged_py = subprocess.run(
            ["git", "show", ":scripts/pod_drift.py"], capture_output=True
        )
        if staged_py.returncode != 0:
            staged_py = subprocess.run(
                ["git", "show", "HEAD:scripts/pod_drift.py"], capture_output=True
            )
        if staged_py.returncode == 0:
            # NOT in scripts/: restartability_audit.py scans that directory, so a
            # concurrent commit sees this temp file, finds a .py absent from its
            # baseline, and FAILs with "[NEW] scripts/.pod_drift_staged.py" -- a file
            # that is gone by the time anyone looks. Cleanup here was never the
            # problem; the location was. Same lesson as the holdout slice sitting in
            # the corpus dir: correct artifact, wrong directory, and the reader
            # downstream cannot tell it from real content.
            tmp_py = os.path.join(
                subprocess.run(["git", "-C", repo, "rev-parse", "--git-path",
                                "pod_drift_staged.py"],
                               capture_output=True, text=True).stdout.strip()
                or os.path.join(repo, ".git", "pod_drift_staged.py"))
            try:
                with open(tmp_py, "wb") as f:
                    f.write(staged_py.stdout)
                r = subprocess.run(
                    [sys.executable, tmp_py, "--write-index"],
                    capture_output=True, text=True,
                )
                if r.returncode == 0:
                    # Consistency: every manifest path must resolve in the index
                    # this commit is built from. In a shared tree the working index
                    # holds everyone's staged paths; GIT_INDEX_FILE (set by git for
                    # `git commit <paths>`) is the commit's actual index.
                    manifest = os.path.join(repo, "data", "pod_head_manifest.txt")
                    if os.path.exists(manifest):
                        bad = []
                        for line in open(manifest):
                            parts = line.strip().split("  ", 2)
                            if len(parts) >= 2:
                                p = parts[1]
                                chk = subprocess.run(
                                    ["git", "show", f":{p}"], capture_output=True,
                                )
                                if chk.returncode != 0:
                                    bad.append(p)
                        if bad:
                            print(f"REFUSING: manifest names path(s) not in this commit's index: {bad[:5]}",
                                  file=sys.stderr)
                            sys.exit(1)
                    subprocess.run(["git", "add", "data/pod_head_manifest.txt"], capture_output=True)
            finally:
                if os.path.exists(tmp_py):
                    os.unlink(tmp_py)
        # If neither staged nor HEAD has pod_drift.py (fresh temp repo), skip
        # manifest regeneration -- the hook must not fail a commit it cannot serve.
    print(f"hook: manifest regen {time.time() - t0:.2f}s", file=sys.stderr)
    print(f"hook: total {time.time() - t_start:.2f}s", file=sys.stderr)


def _selftest():
    """Prove the integration-tree guard both fires and lets a merge through.

    Runs with every GIT_* variable removed from the environment first. git exports
    GIT_DIR (on merge) and GIT_INDEX_FILE to hooks, and a `git init` in a temp
    directory that inherits GIT_DIR re-initialises the SHARED repo instead: core.bare
    flipped to true and the fixture f.txt landed in the real index, twice on
    2026-09-02 (02:49Z and 04:4xZ), taking every session's git down until someone
    unset it. pod_drift.py:61 recorded the mechanism a day earlier, inside one script.

    Two worlds, and the second is the one that mattered: on 2026-09-02 `git merge
    --no-edit e1` on main was REFUSED and left a half-finished merge in the shared
    tree, because git calls this script as pre-merge-commit BEFORE writing
    MERGE_HEAD. Testing only "a plain commit on main is refused" passes on the
    broken version, which is why that version shipped.

    Runs the real hook as a subprocess in a temp repo whose path is declared the
    integration tree, so the guard is live rather than simulated.

    EVERY git call here strips the caller's git environment. The hook runs with GIT_DIR
    set to the committing worktree's gitdir, and `git init` in a fresh directory with
    GIT_DIR inherited reconfigures the SHARED repo instead -- it sets core.bare=true,
    which breaks every git command for every session until someone unsets it. I did
    exactly that at 02:49Z on 2026-09-02 and blocked main for two minutes; the mechanism
    was already written down in pod_drift.py:61-66 and I did not apply it. Reproduced
    since: GIT_DIR must point at a WORKTREE gitdir (.git/worktrees/<name>) for the bare
    flag to be set -- a plain repo's GIT_DIR does not do it, which is why a casual test
    of this looks safe.
    """
    for k in [k for k in os.environ if k.startswith("GIT_")]:
        os.environ.pop(k)

    hook = os.path.realpath(__file__)
    fails = []
    # Same list as pod_drift._GIT_ENV_VARS, for the same reason.
    GIT_ENV = ("GIT_INDEX_FILE", "GIT_DIR", "GIT_WORK_TREE", "GIT_COMMON_DIR",
               "GIT_OBJECT_DIRECTORY", "GIT_CONFIG", "GIT_CONFIG_GLOBAL")
    clean = {k: v for k, v in os.environ.items() if k not in GIT_ENV}

    def run(cwd, argv0, env_extra):
        dst = os.path.join(cwd, argv0)
        shutil.copyfile(hook, dst)
        os.chmod(dst, 0o755)
        env = dict(clean, AUPAI_INTEGRATION_TREE=cwd)
        env.pop("AUPAI_CONTROLLER", None)
        env.update(env_extra)
        r = subprocess.run([sys.executable, dst], cwd=cwd, capture_output=True,
                           text=True, env=env)
        return r.returncode, r.stdout + r.stderr

    d = tempfile.mkdtemp()
    try:
        for a in (["init", "-q", "-b", "main", "."], ["config", "user.email", "t@t"],
                  ["config", "user.name", "t"]):
            subprocess.run(["git"] + a, cwd=d, capture_output=True, env=clean)
        with open(os.path.join(d, "f.txt"), "w") as fh:
            fh.write("base\n")
        subprocess.run(["git", "add", "f.txt"], cwd=d, capture_output=True, env=clean)
        subprocess.run(["git", "commit", "-q", "-m", "base"], cwd=d, capture_output=True,
                       env=clean)

        # WORLD 1 (must REFUSE): an ordinary commit in the integration tree on main.
        rc, out = run(d, "pre-commit", {})
        if rc == 0 or "REFUSING: this is the integration tree" not in out:
            fails.append(f"world 1: a plain commit on main was NOT refused (rc={rc})")

        # WORLD 2 (must PASS): the same script invoked the way `git merge` invokes it.
        # No MERGE_HEAD on disk -- that is exactly the state the old code got wrong.
        if os.path.exists(os.path.join(d, ".git", "MERGE_HEAD")):
            fails.append("world 2 precondition: MERGE_HEAD exists, so it proves nothing")
        rc, out = run(d, "pre-merge-commit", {})
        if "REFUSING: this is the integration tree" in out:
            fails.append("world 2: a merge was refused in the integration tree "
                         "(pre-merge-commit with no MERGE_HEAD yet)")

        # WORLD 3 (must PASS): finishing a CONFLICTED merge, where MERGE_HEAD is on disk.
        with open(os.path.join(d, ".git", "MERGE_HEAD"), "w") as fh:
            fh.write("0" * 40 + "\n")
        rc, out = run(d, "pre-commit", {})
        if "REFUSING: this is the integration tree" in out:
            fails.append("world 3: the commit that resolves a conflicted merge was refused")
        os.unlink(os.path.join(d, ".git", "MERGE_HEAD"))

        # WORLD 4 (must PASS): reflog action says merge, name and MERGE_HEAD say nothing.
        rc, out = run(d, "pre-commit", {"GIT_REFLOG_ACTION": "merge e1"})
        if "REFUSING: this is the integration tree" in out:
            fails.append("world 4: GIT_REFLOG_ACTION=merge was refused")
    finally:
        shutil.rmtree(d, ignore_errors=True)

    # WORLD 5 (must PASS): the OTHER gate. A real linked worktree, diverged from main,
    # merging main in -- which is what the behind-main refusal tells you to do. Needs a
    # true merge, not a fast-forward: a fast-forward runs no hook, which is how this
    # stayed hidden. Kept separate because it needs a worktree, not just a repo.
    d2 = tempfile.mkdtemp()
    try:
        def git(*a, cwd=d2):
            return subprocess.run(["git"] + list(a), cwd=cwd, capture_output=True,
                                  text=True, env=clean)
        for a in (("init", "-q", "-b", "main", "."), ("config", "user.email", "t@t"),
                  ("config", "user.name", "t")):
            git(*a)
        with open(os.path.join(d2, "f.txt"), "w") as fh:
            fh.write("base\n")
        git("add", "f.txt")
        git("commit", "-q", "-m", "base")
        git("branch", "-q", "feat")
        with open(os.path.join(d2, "m.txt"), "w") as fh:
            fh.write("m\n")
        git("add", "m.txt")
        git("commit", "-q", "-m", "main-ahead")
        wt = os.path.join(d2, "wt")
        git("worktree", "add", "-q", wt, "feat")
        hooks = os.path.join(d2, ".git", "hooks")
        os.makedirs(hooks, exist_ok=True)
        for name in ("pre-commit", "pre-merge-commit"):
            dst = os.path.join(hooks, name)
            if os.path.exists(dst):
                os.unlink(dst)
            shutil.copyfile(hook, dst)
            os.chmod(dst, 0o755)
        with open(os.path.join(wt, "d.txt"), "w") as fh:
            fh.write("d\n")
        git("add", "d.txt", cwd=wt)
        env = dict(clean, AUPAI_BEHIND_MAIN_OK="1")
        subprocess.run(["git", "commit", "-q", "-m", "feat"], cwd=wt,
                       capture_output=True, env=env)
        behind = git("rev-list", "--count", "HEAD..main", cwd=wt).stdout.strip()
        r = subprocess.run(["git", "merge", "--no-edit", "main"], cwd=wt,
                           capture_output=True, text=True,
                           env={k: v for k, v in clean.items()
                                if k != "AUPAI_BEHIND_MAIN_OK"})
        out = r.stdout + r.stderr
        if behind == "0":
            fails.append("world 5 precondition: worktree is not behind, proves nothing")
        if "REFUSING: this tree is" in out:
            fails.append("world 5: `git merge --no-edit main` was refused in a worktree "
                         f"{behind} behind main -- the command the refusal itself prints")
    finally:
        shutil.rmtree(d2, ignore_errors=True)

    for f in fails:
        print("SELFTEST FAIL: " + f, file=sys.stderr)
    print("pre-commit selftest: %s (5 worlds)" % ("FAIL" if fails else "ok"),
          file=sys.stderr)
    return 1 if fails else 0


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        sys.exit(_selftest())
    main()
