#!/usr/bin/env python3
"""Pre-commit hook: refuse oversized blobs and unlisted data/ paths; keep pod
manifest fresh from the index.

Install: python scripts/harness.py install-hooks
Bypass: git commit --no-verify (use only for a legitimate new data file,
and say why in the commit message).

The 5MB limit is the same as harness's no_oversized_blob check -- this hook
is the first line (commit time), CI is the second. The data/ allow-list is
the set of paths that may be committed; anything else under data/ is refused
because large data belongs in .gitignore, not history (d535674 swept 234MB
under data/_corpus_unsanitized/ into one commit).

The manifest regeneration writes data/pod_head_manifest.txt from the INDEX
(staged blobs, git show :path), not HEAD or the working tree, so the committed
manifest matches HEAD after the commit lands. This eliminates the "manifest
stale" CI red that required a separate "regenerate pod manifest" commit.
"""
import atexit
import fnmatch
import hashlib
import os
import shutil
import subprocess
import sys
import tempfile

MAX = 5 * 1024 * 1024

ALLOWED = [
    "data/mix_*.json",
    "data/token_cache_pools.json",
    "data/eval/*",
    "data/synthetic/*",
    "data/corpus/sample/*",
    "data/corpus/.counts.json",
    "data/PROVENANCE.md",
    "data/MANIFEST.tsv",
    "data/pod_head_manifest.txt",
    "data/env_fp_baseline.json",
    "data/raw/*_manifest.txt",
    "data/sft/*.py",
    "data/t2s_table.json",
    "data/REBUILD_PLAN_*.md",
    "data/rl/*",
    "data/rl_tasks/*",
    "data/sft_contamination_baseline.json",
]


def repo_root():
    return subprocess.run(["git", "rev-parse", "--show-toplevel"],
                          capture_output=True, text=True).stdout.strip()


def _behind_main():
    """How many commits main has that this tree does not. 0 on main itself, and 0
    when the count cannot be taken -- a tree with no main (a fresh temp repo, a
    clone of one branch) must not be refused for a question that has no answer."""
    r = subprocess.run(["git", "rev-list", "--count", "HEAD..main"],
                       capture_output=True, text=True)
    if r.returncode != 0:
        return 0
    try:
        return int(r.stdout.strip())
    except ValueError:
        return 0


def _merging(common_abs=None):
    """Is this invocation part of a merge? Three signals, because each is absent in
    some real case and MERGE_HEAD alone was wrong in BOTH gates below.

    git runs this one file under two names. `git commit` (finishing a CONFLICTED
    merge) sees MERGE_HEAD already on disk. `git merge` does not call pre-commit at
    all -- it calls pre-merge-commit, symlinked here by cmd_install_hooks -- and on a
    CLEAN merge it calls it BEFORE MERGE_HEAD is written. So a clean merge looks like
    no merge, and both exemptions below silently failed on it:

      integration tree   `git merge --no-edit e1` on main was refused and left a
                         half-finished merge in the shared tree (2026-09-02)
      behind main        `git merge --no-edit main` in a diverged worktree was
                         refused -- the exact command its own message tells you to
                         run (measured 2026-09-02, a true merge, not a fast-forward)

    Both were tested by resolving a CONFLICT, where MERGE_HEAD does exist, so both
    read green. A fast-forward runs no hook at all, which is why the everyday case
    hid it too.

    --git-path resolves MERGE_HEAD per worktree (.git/worktrees/<name>/), which the
    common dir does not; pass common_abs to also accept the integration tree's own
    .git, where the tree check knows the common dir IS .git.
    """
    if common_abs and os.path.exists(os.path.join(common_abs, "MERGE_HEAD")):
        return True
    p = subprocess.run(["git", "rev-parse", "--git-path", "MERGE_HEAD"],
                       capture_output=True, text=True).stdout.strip()
    if p and os.path.exists(p):
        return True
    return (os.path.basename(sys.argv[0]) == "pre-merge-commit"
            or os.environ.get("GIT_REFLOG_ACTION", "").startswith("merge"))


def staged(diff_filter):
    r = subprocess.run(
        ["git", "diff", "--cached", "--name-only", f"--diff-filter={diff_filter}"],
        capture_output=True, text=True,
    )
    return [f for f in r.stdout.splitlines() if f.strip()]


def _shared_repo_state(root):
    """(sha256 of the shared .git/config, staged paths) -- what a selftest must not change.

    Stripping GIT_* from the child stops the leak we know about (e1-12). This measures
    the property instead of the mechanism: whatever a selftest does, the shared repo must
    look the same afterwards. Two cheap reads, ~10ms.

    HASH THE WHOLE FILE, do not enumerate fields (b0's correction, 2026-09-02). The first
    version compared core.bare, because that is the field that broke us -- but `git init`
    under a leaked GIT_DIR rewrites the entire config, and core.bare is merely the most
    lethal line in it. A field list only catches the forms already imagined; the next leak
    adds a remote or bumps repositoryformatversion and passes.

    The leak needs GIT_DIR pointing at a WORKTREE gitdir (.git/worktrees/<name>) -- a
    plain repo's GIT_DIR does not flip core.bare, so a casual test looks safe and only a
    worktree, where every session but the controller works, produces the destructive form.
    Twice on 2026-09-02: a bare flag at 02:49Z (a report at 02:50:39Z records it) and a
    second write at 02:51:08Z while the first was being reproduced. Each took every
    session's git down until someone unset it.

    The first of those was reported as "probably some automation" 45 seconds after the
    reporter had landed a selftest that runs `git init`. The error was the ORDER of
    investigation, not the guess: an external cause is easier to assume and harder to
    refute, while "what did I change in the last 60 seconds" is the one thing you can
    always get evidence for. This check exists so the answer arrives without anyone
    having to ask the question.
    """
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    # --path-format=absolute, not bare --git-common-dir: that returns ".git", relative to
    # the REPO, and realpath resolves it against the caller's cwd instead -- so the digest
    # came back empty from anywhere but the repo root and world 6 reported "no config
    # digest". An empty digest compares equal to an empty digest, so the detector would
    # have passed everything while measuring nothing.
    cfg = subprocess.run(["git", "-C", root, "rev-parse", "--path-format=absolute",
                          "--git-common-dir"],
                         capture_output=True, text=True, env=env).stdout.strip()
    digest = ""
    if cfg:
        path = os.path.join(cfg, "config")
        if os.path.exists(path):
            with open(path, "rb") as fh:
                digest = hashlib.sha256(fh.read()).hexdigest()[:16]
    idx = subprocess.run(["git", "-C", root, "diff", "--cached", "--name-only"],
                         capture_output=True, text=True, env=env).stdout.split()
    return digest, frozenset(idx)


_MANIFEST_RESTORE = {}


def _restore_manifest(repo):
    """Put data/pod_head_manifest.txt back to HEAD's bytes. Never raises.

    ARMED AT THE WRITE, DISARMED AT THE `git add`, and run by atexit -- not called at
    each refusal, which is the version that shipped in 3f5231c and was only accidentally
    complete. That one restored at the two exits that existed below the write; the
    manifest stage simply happens to be the LAST stage today, so there were no others.
    Measured by appending one hypothetical gate after it: the residue came straight back
    (' M data/pod_head_manifest.txt') and with it the livelock. A cleanup whose
    correctness depends on nothing ever being added after it is a trap for whoever adds
    the next gate -- and this file's whole history is gates being added.

    The file is wholly derived -- pod_drift.write_manifest_index builds each line from
    the index and HEAD's own manifest -- so restoring destroys no authored work, which
    is what makes it safe to do on every path that does not commit it.

    A checkout that itself fails is swallowed: this runs while the hook is already
    exiting for a reason worth reporting, and replacing that reason with a git error
    about cleanup loses the finding.
    """
    subprocess.run(["git", "-C", repo, "checkout", "HEAD", "--",
                    "data/pod_head_manifest.txt"], capture_output=True)


def _restore_manifest_atexit():
    repo = _MANIFEST_RESTORE.pop("repo", None)
    if repo:
        _restore_manifest(repo)


atexit.register(_restore_manifest_atexit)


def main():
    # Stage timings in the output: a hook people wait minutes for is a hook they
    # bypass (4a7dd56 --no-verify precedent, 2026-08-31).
    import time

    t_start = time.time()

    # A commit in the INTEGRATION tree, on main, from a session that is not the
    # controller. Three sessions did this tonight (e1 x5, tilerl staged, one merge
    # left unfinished), and the worktree rule was prose until something refused it.
    # Identity is the tree, not the session: a linked worktree's toplevel differs
    # from the common dir's parent, and no session id exists in the environment.
    # AUPAI_CONTROLLER=1 marks the controller's shell; a merge commit is exempt
    # because integrating branches into main is exactly the controller's job.
    t0 = time.time()
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"],
                         capture_output=True, text=True).stdout.strip()
    common = subprocess.run(["git", "rev-parse", "--git-common-dir"],
                            capture_output=True, text=True).stdout.strip()
    if top and common:
        # realpath, not abspath: a symlinked path (/tmp -> /private/tmp on macOS)
        # makes the two sides differ as strings while naming one directory, and the
        # check then silently never fires -- which is how it first tested green.
        common_abs = os.path.realpath(common)
        # THE integration tree, not any repo that happens to be on main: the rule is
        # about the one shared checkout other sessions merge into. Without this every
        # temp repo in the selftest counts as an integration tree, and the tests that
        # commit to main there start refusing (four of them did).
        integration = os.environ.get("AUPAI_INTEGRATION_TREE") or "/Users/bytedance/code/aupai"
        main_tree = (os.path.dirname(common_abs) == os.path.realpath(top)
                     and os.path.realpath(top) == os.path.realpath(integration))
        branch = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                                capture_output=True, text=True).stdout.strip()
        # See _merging: MERGE_HEAD alone is False during a CLEAN merge, because git
        # calls this file as pre-merge-commit before writing it.
        merging = _merging(common_abs)
        if main_tree and branch == "main" and not merging and os.environ.get("AUPAI_CONTROLLER") != "1":
            print(
                "REFUSING: this is the integration tree on main. Commit in your own "
                "worktree and merge:\n"
                "  git -C <your worktree> commit <paths>\n"
                f"  git -C {top} merge --no-edit <your branch>\n"
                "A file left dirty here blocks every other session's move of it and gets "
                "swept into their commits. Controller: AUPAI_CONTROLLER=1 git commit ...",
                file=sys.stderr,
            )
            sys.exit(1)
    print(f"hook: tree check {time.time() - t0:.2f}s", file=sys.stderr)

    # Behind main. A conclusion drawn from a check has two inputs -- the check's code
    # and the tree it ran on -- and we have only ever reported the first. On
    # 2026-09-01 no_foreground_pod_training was fixed four times; 3b hit the version
    # before the first fix, and two sessions each saw the other's item red in their
    # own tree while both were done. "This check has a bug" and "this check has a bug
    # in my tree" are different sentences, and nothing in the output told them apart.
    #
    # Refuse, never merge. An automatic merge can conflict, and a hook that drops your
    # tree into a conflict you did not ask for is worse than one that stops you; an
    # automatic rebase would rewrite history other sessions have already merged
    # (AGENTS.md). Refusal is the only shape that holds: every rule today that
    # depended on remembering broke, and every rule that refused at the point of use
    # held (fb ruling, user order, 2026-09-01).
    t0 = time.time()
    behind = _behind_main()
    # --git-path, not --git-common-dir: in a linked worktree the common dir is the
    # SHARED .git, where MERGE_HEAD never appears -- a worktree's lives in
    # .git/worktrees/<name>/. So the merging exemption was always false here, and this
    # gate refused the merge commit that resolves being behind, which is the one commit
    # it must never block (de, 2026-09-01).
    #
    # The tree check twenty lines above reads MERGE_HEAD the old way and is CORRECT
    # there, which an earlier version of this comment got wrong: its read only runs
    # under `if main_tree`, and in the integration tree the common dir IS .git, so
    # MERGE_HEAD is exactly where it looks. The bug was never the expression -- it was
    # the expression in a context nobody had evaluated it in (e1 caught the
    # overcorrection).
    #
    # --git-path fixed the WHERE and left the WHEN: on a clean merge git calls
    # pre-merge-commit before MERGE_HEAD exists anywhere, so this refused
    # `git merge --no-edit main` -- the command this very message prints. Measured
    # 2026-09-02 in a diverged worktree; the conflict path it was tested on has
    # MERGE_HEAD on disk and passed. Now shares _merging with the tree check (e1-12).
    merging = _merging()
    if behind and not merging and os.environ.get("AUPAI_BEHIND_MAIN_OK") != "1":
        print(
            f"REFUSING: this tree is {behind} commit(s) behind main. Merge first:\n"
            f"  git merge --no-edit main\n"
            f"Committing here writes on top of code main has already moved past, and "
            f"any check you ran said nothing about which version it tested.\n"
            f"Deliberate exception (reproducing something that only fails on the older "
            f"code): AUPAI_BEHIND_MAIN_OK=1 git commit ... -- the cost is that this "
            f"commit and every check behind it describe a tree nobody else has.",
            file=sys.stderr,
        )
        sys.exit(1)
    print(f"hook: behind-main {time.time() - t0:.2f}s ({behind} behind)", file=sys.stderr)

    t0 = time.time()
    fail = False
    for f in staged("AM"):
        if os.path.isfile(f):
            sz = os.path.getsize(f)
            if sz > MAX:
                print(
                    f"REFUSING: {f} is {sz} bytes (>5MB) -- "
                    f"large files are gitignored, not committed", file=sys.stderr,
                )
                fail = True
    for f in staged("A"):
        if f.startswith("data/") and not any(fnmatch.fnmatch(f, p) for p in ALLOWED):
            print(
                f"REFUSING: {f} is a new data/ path not in the allow-list -- "
                f"add to scripts/hooks/pre-commit ALLOWED or use --no-verify "
                f"with justification", file=sys.stderr,
            )
            fail = True
    if fail:
        sys.exit(1)
    print(f"hook: blob+allowlist {time.time() - t0:.2f}s", file=sys.stderr)

    # A staged runs/*.jsonl must not lose a record. de-33.
    #
    # a59ac1f staged a runs/experiments.jsonl one line shorter than its parent and dropped b0's
    # ab_zeroinit AMENDMENT row. All five hook lines were green; b0 found it by eye, reading
    # "1 -" in the diffstat. These files merge by union, so a row that leaves is not a conflict
    # anyone resolves -- it is a record that stops existing.
    #
    # The predicate lives in scripts/ledger_audit.py (b0) over de's subsume/key_present, and is
    # PER LEDGER because the write tools differ: exp.py appends, harness.py:5805 rewrites
    # tasks.jsonl whole, score_matrix.py:573 replaces a row by design. Subsumption everywhere
    # would refuse 30 of tasks.jsonl's last 161 commits -- all of them a plain
    # `harness task done`. That is why this calls regressions() instead of comparing lines.
    #
    # WHY THE ESCAPE IS AN ENV VAR AND NOT A COMMIT-MESSAGE MARKER: git does not pass the
    # message to pre-commit, and .git/COMMIT_EDITMSG at this point still holds the PREVIOUS
    # commit's message. Measured four ways in a real repo (de, 2026-09-03): the first commit
    # sees no file at all, and a plain commit right after a marked one reads the marker it did
    # not write. An exception keyed on that would exempt commits nobody declared and refuse the
    # ones that were. AUPAI_LEDGER_REWRITE names the intent of THIS invocation, and unlike
    # --no-verify it does not also skip blob size, ruff, the selftests and harness check.
    t0 = time.time()
    _ledger_note = ""
    try:
        sys.path.insert(0, os.path.join(repo_root(), "scripts"))
        import ledger_audit as _la

        _staged_ledgers = [f for f in staged("M") if f in _la.PREDICATE]
        _why = os.environ.get("AUPAI_LEDGER_REWRITE", "").strip()
        _hits = []
        _dups = []
        for f in _staged_ledgers:
            head = subprocess.run(["git", "show", f"HEAD:{f}"], capture_output=True, text=True)
            index = subprocess.run(["git", "show", f":{f}"], capture_output=True, text=True)
            if head.returncode or index.returncode:
                continue
            bad = _la.regressions(f, head.stdout, index.stdout)
            if bad:
                _hits.append((f, bad))
            # A duplicate key, on the one ledger whose writer cannot produce one. Scoped by
            # DUP_IS_FAULT, not applied file-wide: exp.py APPENDS events under the start row's
            # key, so experiments/tasks/board/retro carry duplicates by design and a file-wide
            # rule would refuse 99 keys in tasks alone.
            _dups.extend((f, k) for k in _la.duplicates(f, index.stdout))
        if _hits:
            total = sum(len(b) for _, b in _hits)
            for f, bad in _hits:
                print(f"{'ALLOWING' if _why else 'REFUSING'}: {f} loses {len(bad)} record(s) "
                      f"-- these files merge by union, so a row that leaves is a record that "
                      f"stops existing (de-33: a59ac1f dropped b0's ab_zeroinit amendment "
                      f"under five green hook lines)", file=sys.stderr)
                for key, row in bad[:4]:
                    print(f"    - {key}", file=sys.stderr)
                if len(bad) > 4:
                    print(f"    ... and {len(bad) - 4} more", file=sys.stderr)
            if _why:
                # Hand the finding to commit-msg, which is the only hook that sees THIS
                # commit's message. The env var is a pass; the marker file is what forces the
                # reason into history, where a reader six weeks out can find it.
                _mark = subprocess.run(
                    ["git", "rev-parse", "--git-path", "AUPAI_LEDGER_REGRESSED"],
                    capture_output=True, text=True).stdout.strip()
                if _mark:
                    try:
                        with open(_mark, "w", encoding="utf-8") as fh:
                            fh.write("\n".join(f"{f} {key}" for f, bad in _hits for key, _ in bad))
                    except OSError:
                        pass
                print(f"AUPAI_LEDGER_REWRITE={_why!r} -- allowed here; commit-msg will require "
                      f"`ledger-rewrite: <why>` in the message. The env var is not recoverable "
                      f"from history, so the message is the only place the reason survives.",
                      file=sys.stderr)
                _ledger_note = f", {total} loss(es) ALLOWED by AUPAI_LEDGER_REWRITE"
            else:
                print("If the loss is intentional -- reconciling duplicate rows from a pod "
                      "sync is the real case -- re-run with "
                      "AUPAI_LEDGER_REWRITE='<why>' and say the same thing in the commit "
                      "message. Do NOT use --no-verify: it also skips blob size, ruff, the "
                      "selftests and harness check.", file=sys.stderr)
                sys.exit(1)
        if _dups:
            # Judge the DELTA, not the presence. score_matrix.jsonl carried 22 duplicates until
            # 44's fold landed, and "any duplicate refuses" would have refused the folding commit
            # itself along with every other commit touching the file. Refuse only a key that HEAD
            # did not already have duplicated; a commit that leaves or reduces them says so in
            # the count line and passes.
            _added = []
            for f in {f for f, _ in _dups}:
                head = subprocess.run(["git", "show", f"HEAD:{f}"], capture_output=True, text=True)
                was = set(_la.duplicates(f, head.stdout)) if not head.returncode else set()
                _added += [(f, k) for g, k in _dups if g == f and k not in was]
            if _added:
                for f, k in _added[:6]:
                    print(f"REFUSING: {f} has more than one row under {k}, which HEAD did not. "
                          f"Its writer replaces the same key by design "
                          f"(eval/score_matrix.py:573), so a second row is not something it "
                          f"can produce -- it arrives through a cross-branch union merge, "
                          f"where the .lock does not reach.", file=sys.stderr)
                if len(_added) > 6:
                    print(f"    ... and {len(_added) - 6} more", file=sys.stderr)
                print("Fold the duplicate rows and commit the folded file, or if the "
                      "duplication is real, re-run with AUPAI_LEDGER_REWRITE='<why>'.",
                      file=sys.stderr)
                if not _why:
                    sys.exit(1)
            else:
                _ledger_note += (f", {len(_dups)} pre-existing duplicate key(s) "
                                 f"(none added)")
    except ImportError:
        _ledger_note = ", ledger_audit absent (SKIP)"
    print(f"hook: ledger-append-only {time.time() - t0:.2f}s "
          f"({len(_staged_ledgers) if '_staged_ledgers' in dir() else 0} staged"
          f"{_ledger_note})", file=sys.stderr)

    # Ruff E9/F on staged .py files -- the same gate CI runs, caught at commit time.
    t0 = time.time()
    py_files = [f for f in staged("AM") if f.endswith(".py")]
    if py_files:
        try:
            r = subprocess.run(
                ["ruff", "check", "--select", "E9,F", *py_files],
                capture_output=True, text=True,
            )
            if r.returncode != 0:
                print(f"REFUSING: ruff E9/F failed:\n{r.stdout}", file=sys.stderr)
                sys.exit(1)
        except FileNotFoundError:
            pass  # ruff not installed; CI catches it
    print(f"hook: ruff {time.time() - t0:.2f}s", file=sys.stderr)

    # A staged file that carries its own --selftest must pass it. Today a readout
    # commit landed with its selftest RED: the assertion pinned the old wording of a
    # refusal message and the message had been reworded in the same commit. Nothing
    # ran it, so the hook printed five green lines over a broken guard -- the hook
    # checked what it happened to check, not what the commit changed (b0, 2026-09-01).
    # Run from the SELFTEST_FILES map rather than probing for the flag: a script that
    # exits 0 on an unknown argument would otherwise register as a pass.
    t0 = time.time()
    # Every file carrying its own --selftest, split by whether it can run at commit
    # time on a dev box. check_selftests_are_gated requires the union to be complete,
    # so a new selftest cannot be silently unguarded; NEEDS_DATA records WHY each one
    # is not run here, because "not in the map" and "cannot run here" are different
    # facts and only the second is acceptable.
    SELFTEST_FILES = {
        "eval/readout_30b.py", "eval/math_v2_like.py", "eval/score_matrix.py",
        # lambada_en's selftest needs neither tokenizer nor data -- it covers the stop rule
        # and the row splitter, both pure string logic -- so it belongs here and not in
        # NEEDS_DATA. It caught two defects in its own file before that file's first commit:
        # a `required=True` on --ckpt that made `--selftest` itself un-runnable, and a
        # comment claiming the hyphen was a word boundary while the set omitted it.
        "eval/lambada_en.py",
        # humaneval gold BPB: its selftest needs no data and no model -- a uniform-distribution
        # stand-in has a known answer (log2(V) bits/byte exactly), which is what pins the bit
        # conversion, the byte divisor, the prompt-carries-no-loss split, and the refusal to
        # truncate a solution. All four verified red on their broken worlds.
        "eval/humaneval_bpb.py",
        # domain BPB: same known answer (log2(V) on a uniform model), and it also pins the
        # first-token exclusion via chunk-invariance and the decode round-trip measure that
        # certifies both arms score the same bytes. Four broken worlds verified red.
        "eval/domain_bpb.py",
        "eval/score_math_formatfree.py", "eval/score_code_exec.py",
        "eval/cache_guard.py", "eval/pairwise_judge.py",
        "probes/chatml_in_corpus.py",
        "scripts/doc_numbers_check.py", "scripts/replay_cursor.py",
        "scripts/card_claim.py",
        # retract: a read-only grep over a temp tree -- no data, no card.
        "scripts/retract.py",
        "scripts/test_exp_done_started.py",
        "scripts/write_mix_500m.py", "scripts/ckpt_health.py",
        "scripts/restartability_audit.py", "scripts/shape_audit.py",
        "scripts/tokenizer_eval.py", "scripts/tokenizer_report.py",
        "scripts/launch_gate.py", "scripts/test_num_id_resolve.py",
        "scripts/test_serve_history.py",
        "scripts/test_tokenizer_fp_name.py",
        "scripts/test_facts_olmes_urls.py",
        "scripts/test_reachability_fresh.py",
        "scripts/test_eval_load_only.py",
        "scripts/test_pod_drift_root.py",
        "scripts/launch_tests.py",
        "algorithms/isolate.py",
        "algorithms/code_reward.py",
        "algorithms/rollout.py",
        "algorithms/seccomp.py",
        "datagen/build_corpus.py", "datagen/clean_web.py", "datagen/distil_traces.py",
        "datagen/fetch_corpus.py", "datagen/score_web_27b.py",
        "probes/t71_depth_lr_rule.py",
        "scripts/stale_claims.py",
        "scripts/trace_classes.py",
        "scripts/test_drop_zombies.py",
