        # that changes this file records the result. It was legitimately absent from both
        # maps until now: the file ran its checks as `_self_check()` under `if __name__`
        # with no `--selftest` string anywhere, so the gate's scan had nothing to match
        # (VERIFIED against HEAD before writing this). The seccomp commit added the string
        # in a docstring, which is what pulled it into scope (de, 2026-09-02).
        "datagen/sandbox_exec.py": "17 known answers, all needing root + unshare for the "
                                   "chroot and namespaces; pod only, run by hand",
        "eval/code_l0prime.py": "sandbox_exec needs root (chroot + namespaces); pod only",
        "scripts/count_tokens.py": "reads corpus shards, which are gitignored",
        # Two more de-5 candidates that PASS and assert live properties, but only where the
        # corpus and tokenizer are (fb's ruling: run it before judging it). Both measured on
        # the pod 2026-09-02:
        #   test_resume_cursor_pod  a cursor moves the planned rows (50.0% overlap against
        #                           an ignored cursor's 100%), no silent discard,
        #                           _plan_trimmed true, and the seed guard fires
        #   test_domain_loss_val    val_seqs returns train.py's held-out rows, disjoint
        #                           from the training pool -- after this commit fixes its
        #                           fixture key from "text" to "content", which is why it
        #                           died in its own setup and read as unrunnable
        "scripts/test_resume_cursor_pod.py": "needs data/tokenizer.json and data/corpus/, "
                                             "both gitignored; run on the pod",
        "scripts/test_domain_loss_val.py": "needs data/tokenizer.json, gitignored; SKIPs "
                                           "cleanly here and passes on the pod",
        # Kept rather than deleted in de-21, and listed here so the reason it is not run is
        # recorded rather than absent. It is the ONLY assertion that _encode_domain(workers>1)
        # is element-identical to workers=1 (train.py:1682, the live path that writes every
        # run's /data00 token cache; `harness pretokenize --workers 8` is the documented
        # entry). .srcfp fingerprints the source directory, not the encode path, so nothing
        # else would notice a divergence. It has NO --selftest flag -- its whole body IS the
        # assertion, run as `python3 scripts/test_parallel_encode.py` -- so the hook could
        # not invoke it even where the data existed; the honest entry says pod-only, which is
        # true for both reasons. selftests_are_gated does not require it (42 selftest-carrying
        # files, and this is not one).
        "scripts/test_parallel_encode.py": "needs data/tokenizer.json and the math_seed "
                                           "corpus, both gitignored, and carries no "
                                           "--selftest flag; run it on the pod by hand",
        "eval/base_matrix.py": ("asserts data/tokenizer.json, which is gitignored; the "
                                "partial flag runs ONLY _selftest_floor (the MC floor "
                                "arithmetic, 0.05s), NOT the minimal-pair construction or "
                                "the stub-scorer plumbing, which both need the tokenizer",
                                "--selftest-nodata"),
