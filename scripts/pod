#!/usr/bin/env bash
# infra-layer: moves to aupai-infra at the split (6e ruling 2026-09-04).
#
# pod — run a command INSIDE the `sglang-test` static-pod container (the sglang
# cu129 image, all 8 H20 GPUs visible) via the tn tunnel -> crictl exec. The
# node's kubelet kubeconfig can only create mirror/static pods and cannot
# `kubectl exec`, so we drive the container through crictl (node-local
# containerd, no API RBAC).
#
#   pod 'nvidia-smi'
#   pod 'cd /work/aupai && python3 scripts/exp.py list'
#
# VENDORED 2026-09-04. It lived only in ~/bin, untracked, while every session and
# five tracked scripts depended on it -- a tree that does not contain its own
# entry points cannot be split. `~/bin/pod` is now a symlink here; see the Pod
# section of AGENTS.md for the one-time per-laptop install.
#
# THE CONTRACT'S exec VERB. It never interprets the command. Two refusals below
# are the exception, and each exists because the failure is silent otherwise.
set -euo pipefail

# --view before anything else: it must not be swallowed into user_cmd. Prints which
# filesystem the next command sees, because the wrong view does not error -- it
# answers, with a world that looks stale rather than absent (AGENTS.md, measured
# 2026-09-03: a host-view grep agreed with a second wrong reading, and two wrong
# views agreeing is what made it convincing).
if [ "${1:-}" = "--view" ]; then
  echo "container view (crictl exec into ${POD_NAME:-sglang-test}): /work/aupai is the live tree."
  echo "  host view is 'tn exec <cmd>' -- same paths, different directories."
  exit 0
fi

user_cmd="${*:-bash -l}"
pod_name="${POD_NAME:-sglang-test}"

# REFUSAL: `cd X && ... &` — the cd does not survive into the background chain.
# Measured (shape 166, e1 2026-09-04): three inline background forms produce NO
# log file at all, not an empty one, so the redirect never ran. The container's
# default cwd is /sgl-workspace/sglang, so a relative path in the backgrounded
# half resolves under a tree that has no runs/. The working form is already in
# scripts/launch_30b.sh:141 -- write the command to a file on the pod, then
# `setsid bash runs/foo.sh > log 2>&1 &`.
#
# THE `&` NEED NOT END THE STRING, and the old predicate required it to
# (`&[[:space:]]*$`). Measured 2026-09-05, five real shapes passed the guard, ran
# nothing, wrote no log, and printed their own success line:
#   cd X && cmd > log 2>&1 & ; sleep 3; echo launched      <- 4c's report
#   cd X && cmd > log 2>&1 & sleep 3
#   cd X && cmd & echo started
#   cd X && setsid bash runs/x.sh > runs/x.log 2>&1 & tail -f runs/x.log
#   cd X; nohup cmd & wait
# A trailing `&` is one way to background a list, not the definition of one.
#
# THREE STEPS, and the order is the design. The risk here is entirely false
# positives -- this sits in front of every command anyone types at the pod, so
# eating a legitimate `cd` is worse than the bypass it closes.
#   1. DELETE backslash-escapes, then quoted spans. `grep -n "foo & bar"` carries
#      an `&` that is not an operator; nine of the measured negative controls are
#      that shape. Escapes go first or `"...\"&\"..."` splits the strip and the
#      inner `&` survives -- one false positive, caught by the population run.
#   2. NEUTRALIZE the non-background `&`: `&&` (list separator) and `>& <& |&`
#      (fd duplication, i.e. every `2>&1`).
#   3. Whatever `&` survives is a background operator.
# Verified on 30 shapes: the 5 bypasses above and the 3 the old guard caught all
# refuse; 22 accept, including `cd X && grep -c "a && b" AGENTS.md`,
# `cd X && ls 2>&1 | tail -2`, and this repo's own doc command lines.
#
# WHAT THIS DOES NOT CATCH, checked rather than assumed: the two 17-hour loops
# live when this was written are NOT this shape. Their argv is
# `bash -lc until grep -q ALL-DONE runs/x.log; do sleep 5; done` -- no cd at all
# and no `&` anywhere. Whatever was supposed to cd never appeared in the command,
# so no inspection of the command string can see it. Those are class (b) in
# env_hygiene, caught by resolving the target against the process's own cwd AFTER
# it is running. A launch-time guard and a runtime sweep catch different halves,
# and neither subsumes the other.
_bg_scan=$(printf '%s' "$user_cmd" | sed -e 's/\\./@/g' -e "s/'[^']*'//g" \
                                         -e 's/"[^"]*"//g' -e 's/&&/@/g' \
                                         -e 's/[><|]&/@/g')
if printf '%s' "$_bg_scan" | grep -qE '(^|[;&|[:space:]])cd[[:space:]]' \
   && printf '%s' "$_bg_scan" | grep -q '&'; then
  echo "pod: refusing a 'cd ... &' shape -- the cd does not reach the backgrounded half," >&2
  echo "  so a relative path resolves under /sgl-workspace/sglang and the redirect silently" >&2
  echo "  does not run (no log file at all, shape 166). Write the command to a file on the" >&2
  echo "  pod and 'setsid bash runs/<name>.sh > runs/<name>.log 2>&1 &' instead" >&2
  echo "  (scripts/launch_30b.sh:141). POD_ALLOW_BG_CD=1 overrides." >&2
  [ -n "${POD_ALLOW_BG_CD:-}" ] || exit 1
fi

remote="cid=\$(crictl ps -q --name $(printf '%q' "$pod_name") --state Running 2>/dev/null | head -1); "
remote+="if [ -z \"\$cid\" ]; then echo \"pod: $pod_name container not Running yet\"; crictl ps -a --name $(printf '%q' "$pod_name") 2>/dev/null | tail -2; exit 1; fi; "
remote+="crictl exec \$cid bash -lc $(printf '%q' "$user_cmd")"
exec tn exec "$remote"
