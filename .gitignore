.venv/
__pycache__/
*.pyc
ckpt*.pt
data/tokenizer.json
data/*.jsonl
data/sft/*.jsonl
data/sft/*.jsonl.gz
# ...and every other shape a dataset arrives in. Only *.jsonl was ignored, so
# qwq_mmlu.parquet (45MB) and gsm8k_zh.json (8.9MB) were committed.
data/sft/*.parquet
data/sft/*.json
data/mix/
data/**/*.pt
data/rl/
data/synthetic/
data/augmented/
data/outbatch/
data/workbatch/
.ruff_cache/
.DS_Store

# raw math sources and built domain shards: hundreds of MB, GitHub caps a file at
# 100 MB, and every one is either frozen-and-archived or rebuildable. The 5,052-doc
# sample corpus at data/corpus/*.jsonl stays tracked -- it is what makes a fresh
# clone runnable.
data/math/
data/corpus/*/
!data/corpus/primary/
data/tokenizer_k5.json
data/tokenizer_k6.json

# Quarantine: files moved here are the UNFILTERED originals kept for re-cutting, and they
# are large (rlvr_math 40MB; AGENTS.md's corpus quarantine is 13GB). data/rl/ and
# data/corpus/*/ are ignored, so MOVING a file to data/_quarantine/ un-ignores it -- which
# is how a 218,468-line jsonl reached a commit.
data/_quarantine/
data/_corpus_unsanitized/

# Pod-only build artifacts: raw sources and eval prediction files. Rebuildable,
# never committed -- a fact that cites them is machine-verifiable on the pod,
# SKIPped on a dev checkout (same three-state rule as data/corpus/*).
data/raw/
data/eval/preds_*.jsonl
runs/board.html
# Per-machine, per-run state: which checks hit their deadline on the LAST run here.
# Committing it would carry one machine's slowness into everyone's strike count.
runs/check_timeouts.json
.cache/

# Generated by scripts/plot_curves.py from run logs; regenerate, never commit.
plots/
runs/.board_seen.json

# Chrome traces from torch.profiler: 57MB for 3 steps of the 200M, and the pre-commit hook
# refuses anything over 5MB, so these can only ever live on the pod. Same three-state rule as
# data/raw/ -- a fact citing one is machine-verifiable there and SKIPped on a dev checkout,
# rather than sitting in the missing-source baseline as debt that will never be paid. The
# DERIVED table is what belongs in the repo (facts/efficiency.json, scripts/trace_classes.py).
runs/trace_*.json

# eval/score_matrix.py's flock file, created beside the ledger on every write_records call.
# Untracked and unignored, it shows up in `git status` for whoever writes the matrix next and
# gets swept into a `git add`; a lock is per-machine state, never history.
runs/*.jsonl.lock

# GENERATED, not authored: scripts/pod_push.sh writes it from the HEAD it ships, and ships it
# last so a partial push leaves the OLD manifest -- which --check correctly calls drift --
# rather than a new one vouching for files that never landed. Tracking it was the top friction
# cause (4 of 15 rows in runs/friction.jsonl): the pre-commit hook regenerated it on every
# commit, so any two branches that both committed collided on it, and in a merge commit the
# regen ran after git had built the tree, so it could only land in the index -- permanently
# dirty against HEAD, aborting the next merge (shape A, 6e ruling 2026-09-04).
data/pod_head_manifest.txt
